# Environment for the Cloudflare Pages site and Pages Functions (functions/).
# Copy to `.env` (or `.dev.vars` for local Cloudflare Pages dev). Never commit
# the filled-in version — .env and .dev.vars are gitignored.
#
# For PRODUCTION set every value in:
#   Cloudflare Dashboard → Pages → <project> → Settings → Variables and Secrets
# "Cloudflare Pages secret" = type Secret (encrypted); "Cloudflare Pages variable"
# = plaintext. Set both in Production, and in Preview when previews need them.
# Pages Functions only read Cloudflare env vars, never this file.
#
# Format (checked by tests/env-inventory.test.mjs; `node scripts/env-inventory.mjs`
# lists every variable the code reads): each variable has ONE comment line
# directly above it — what it does, "Unset:" behaviour, then
# [secret|plain; where it is set]. When code reads A || B, document A (B is a
# fallback). Variable names that code also accepts as aliases are listed in
# docs/env-inventory.md. Never put real values here.

# ── Hub identity, sessions and the employee vault ─────────────────────────

# Dedicated random signing key for staff and customer HttpOnly sessions.
# Generate at least 32 random bytes. Never reuse a CRM, Firebase, Stripe, or
# webhook credential here.
# Signs staff and customer session cookies and roots the v2 operations service keys (32+ random bytes); while HUB_PURPOSE_KEY_SECRET is unset it also roots the sealed website-lead receipts, so rotating it makes every unsynced sealed lead unreadable (abandoned as payload_unreadable; set HUB_PURPOSE_KEY_SECRET before WEB_LEAD_RECEIPTS_ENABLED). Unset: every Hub sign-in fails closed. [secret; Cloudflare Pages secret]
HUB_SESSION_SECRET=
# Optional dedicated root (32+ random chars) for purpose-scoped keys (two-step confirmation tokens, future magic links and rate limits, sealed website-lead receipts); once set it is always used, and changing it voids outstanding 5-minute confirmations and leaves unsynced sealed website leads unreadable. Unset: keys derive from HUB_SESSION_SECRET via HKDF. [secret; Cloudflare Pages secret]
HUB_PURPOSE_KEY_SECRET=

# Built-in Hub accounts belong in an encrypted secret, never in repository code.
# Built-in Hub accounts as JSON {username: {passwordHash, displayName, role, payType, hourlyRate}}. Unset: no built-in staff account can sign in. [secret; Cloudflare Pages secret]
HUB_AUTH_USERS_JSON={"<username>":{"passwordHash":"<generated-pbkdf2-hash>","displayName":"<display name>","role":"<owner|manager|sales|crew_lead|crew>","payType":"<owner|hourly>","hourlyRate":0}}
# Leave HUB_AUTH_USERS_JSON intact. Duplicate usernames (case/space-insensitive)
# within either map or across maps fail closed instead of replacing credentials.
# NEW staff accounts only, same record format as HUB_AUTH_USERS_JSON. Unset: only HUB_AUTH_USERS_JSON accounts exist. [secret; Cloudflare Pages secret]
HUB_AUTH_ADDITIONAL_USERS_JSON={}
# The private auth-verifier Worker (auth-verifier/README.md) derives stored
# PBKDF2 hashes when the Workers runtime caps the iteration count. It is a
# binding, not a text variable: never put it in .env/.dev.vars.
# Durable Object binding to class PasswordVerifier in Worker egc-password-verifier. Unset: HUB_PASSWORD_HASH_FALLBACK decides; otherwise capped-iteration sign-ins fail closed. [plain; Cloudflare Pages Durable Object binding]
# HUB_PASSWORD_VERIFIER=<Durable Object binding egc-password-verifier/PasswordVerifier>
# Exactly "enabled" derives capped-iteration password hashes in JavaScript for runtimes without the verifier binding. Unset: no in-process fallback. [plain; Cloudflare Pages variable]
HUB_PASSWORD_HASH_FALLBACK=
# Exactly "on" makes the edge require a Hub staff session for the staff pages and scripts listed in staff-paths.js (signed-out page visits go to /staff-login or /crew/, other requests get 401); only deployments built after it is set are gated, so put preview and older deployment URLs behind Cloudflare Access or delete them; turn on in Preview first; roll back by setting off and retrying the latest deployment (no code change). Unset: off, those files stay publicly downloadable exactly as before. [plain; Cloudflare Pages variable]
EGC_STAFF_PAGE_GATE=off

# Preserve the EXACT historical employee vault secret before configuring a new
# session secret. Existing records used EMPLOYEE_HUB_DATA_SECRET, HUB_SESSION_SECRET,
# or (older deployments only) the historical HighLevel key, in that priority order.
# A new value cannot decrypt existing accounts, timecards, training, or messages.
# Use a dedicated independent vault key for new installations. Never rotate it
# without a verified data migration. See docs/employee-hub-recovery.md.
# Employee vault key for accounts, timecards, training, messages and Gusto tokens. Unset: EMPLOYEE_HUB_LEGACY_KEY_SOURCE, then HUB_SESSION_SECRET is the vault key. [secret; Cloudflare Pages secret]
EMPLOYEE_HUB_DATA_SECRET=
# Optional recovery ONLY when existing records used the currently sealed CRM key.
# This is not an implicit key fallback. Keep the dedicated secret unset for this
# path. Unknown/missing selected keys fail closed.
# Recovery selector; the only accepted value is HIGHLEVEL_API_KEY (use the CRM key as the historical vault key). Unset: normal vault key order. [plain; Cloudflare Pages variable]
EMPLOYEE_HUB_LEGACY_KEY_SOURCE=
# Leave false until BOTH historical account and employee-Hub families are readable.
# Then set true and redeploy. RETAIN the selector and original CRM key afterward.
# Exactly "true" re-enables vault writes once legacy-key recovery is verified readable. Unset: the vault is read-only while a legacy key source is selected. [plain; Cloudflare Pages variable]
EMPLOYEE_HUB_LEGACY_WRITES_VERIFIED=false
# Escape hatch for employee vault reads: exactly "legacy" decrypts the whole vault instead of querying one record family (use only if family reads fail with a storage query error, then redeploy). Unset: per-family queries, falling back on their own when Firestore reports a missing index. [plain; Cloudflare Pages variable]
EGC_EMPLOYEE_VAULT_QUERY=
# Exactly "true" turns on /api/staff-directory (versioned roles, skills, effective-dated pay and weekly availability on the sealed profiles), the roster skills/availability, and the owner-only pay lock on legacy profile saves; run the staff-profile-pay-roles-v1 and employee-account-staff-roles-v1 vault migrations first. Unset: the directory returns 503 staff_directory_not_enabled and legacy profile saves follow EGC_STAFF_PAY_OWNER_ONLY. [plain; Cloudflare Pages variable]
EGC_STAFF_DIRECTORY_ENABLED=
# Exactly "true" gives accounts with stored staffRoles exactly those roles' capabilities (owner capabilities stay owner-only). Unset: the hard-coded business-access, dispatcher and owner checks decide. [plain; Cloudflare Pages variable]
EGC_STAFF_ROLE_PERMISSIONS=
# Exactly "false" restores the older rules. Pay: every business user sees each employee's pay (payType, hourlyRate, timecard grossEstimate, bonus, tips and any stored rate-like pay key such as ptoRate) on profiles, timecards and time-off requests in /api/employee-hub reads, sees each employee's rate and gross pay in /api/timesheets, downloads its payroll CSV, and can change pay fields on profiles, timecards and time-off requests, and move timecards and time-off requests between employees, through /api/employee-hub. Job labor dollars: every operations manager (owner or manager role) sees and enters them (per-employee and per-job labor cost, overtime premium and totals in /api/job-costing, laborCents in /api/money, the figures in /api/job-labor-costs, and the labor, direct cost, contribution and margin on the Hub finance board); a crew lead or sales account with business access still sees them in /api/job-costing, but its finance board says "Labor $ hidden" (/api/job-labor-costs answers it 403 job_labor_forbidden). Each labor save is written onto the job as before (costs.labor, and costs.laborCents from /api/money), and also keeps the figure in the server-only jobLaborCosts record, with a receipt and an owner-only audit entry; the finance board and /api/money read that record first, so the figures stay the same when the flag is turned back on. Figures round-trip to the cent: the record holds whole cents, the job gets them back as dollars, and scripts/backfill-job-labor-private.mjs --restore writes each record back onto its job as costs.labor and costs.laborCents (an older sub-cent figure such as 311.195 comes back as 311.2). Unset: only the owner (pay.manage) sees other employees' pay in /api/employee-hub and /api/timesheets and downloads the payroll CSV; anyone else's pay-field change is refused with 403 pay_owner_only, as is any pay field (even an unchanged one) sent to another employee's record and any move of a timecard or time-off request to another employee; managers keep hours, approvals and paid time-off hours, and everyone sees their own pay. Only the owner sees and enters job labor dollars, kept in the server-only jobLaborCosts record and off the job, while everyone else gets the same hours with laborCostHidden:true, hidden totals null (never 0), and "Labor $ hidden" on the finance board. [plain; Cloudflare Pages variable]
EGC_STAFF_PAY_OWNER_ONLY=
# Independent signing key for customer portal links and sessions. Unset: HUB_SESSION_SECRET signs them. [secret; Cloudflare Pages secret]
CUSTOMER_PORTAL_SECRET=
# Google review link shown in the customer portal once a job is completed and paid (https only, max 500 chars). Unset or invalid: the built-in Easy Garage Cleaning Google place review link. [plain; Cloudflare Pages variable]
GOOGLE_REVIEW_URL=
# Exactly "true" makes the customer portal refuse to approve estimates still in 'draft' status (approvable:false, 409 CUSTOMER_PORTAL_ESTIMATE_NOT_APPROVABLE); keep it unset until the Hub writes a released status such as 'sent' when an estimate is confirmed ready. Unset: drafts stay approvable as today. [plain; Cloudflare Pages variable]
CUSTOMER_PORTAL_REJECT_DRAFT_ESTIMATES=

# ── Firebase / Firestore (the Hub source of truth) ────────────────────────

# Store the whole downloaded JSON object as an encrypted secret; never commit it.
# Server-only service account (project egcw-1ec83) for Firestore REST and employee custom tokens. Unset: every Firestore-backed Hub API reports not configured. [secret; Cloudflare Pages secret]
FIREBASE_SERVICE_ACCOUNT_JSON=<whole downloaded service-account JSON object for project egcw-1ec83>
# The public Firebase Web API key lives in the browser pages, not here.
# Server code reads this only to recognise synthetic firebase-test-* keys in unit tests. Unset: normal production behaviour. [plain; tests only, leave unset in Cloudflare Pages]
FIREBASE_API_KEY=

# ── HighLevel CRM and two-way client messaging ────────────────────────────
# Crew messages use the linked job contact (never a browser-supplied number);
# client portal replies are mirrored into the same HighLevel conversation.
# In the HighLevel Marketplace/OAuth app, subscribe the InboundMessage event to
# https://easygaragecleaning.com/api/highlevel-message-event — it rejects
# requests unless the Ed25519 X-GHL-Signature is valid and the location matches.

# HighLevel private-integration token for CRM sync, portal invites, messaging and web leads. Unset: HighLevel features report not configured. [secret; Cloudflare Pages secret]
HIGHLEVEL_API_KEY=
# HighLevel location (sub-account) id every contact must belong to. Unset: HighLevel features report not configured. [plain; Cloudflare Pages variable]
HIGHLEVEL_LOCATION_ID=
# HighLevel user assigned to new web leads and used for messages and notes. Unset: /api/highlevel uses the built-in EGC user; other senders omit the user. [plain; Cloudflare Pages variable]
HIGHLEVEL_USER_ID=
# Never use the Employee hiring calendar for either calendar below.
# HighLevel calendar for walkthrough appointments. Unset: the verified EGC walkthrough calendar when the EGC location is configured, else none. [plain; Cloudflare Pages variable]
HIGHLEVEL_WALKTHROUGH_CALENDAR_ID=
# HighLevel calendar for job appointments. Unset: the verified EGC jobs calendar when the EGC location is configured, else none. [plain; Cloudflare Pages variable]
HIGHLEVEL_JOB_CALENDAR_ID=
# Sales pipeline for web-lead opportunities, stage moves and follow-up exits. Unset: /api/highlevel and follow-up exits use the built-in EGC pipeline; /api/web-lead creates no opportunity. [plain; Cloudflare Pages variable]
HIGHLEVEL_PIPELINE_ID=
# Pipeline stage for new website-lead opportunities. Unset: the first stage of HIGHLEVEL_PIPELINE_ID. [plain; Cloudflare Pages variable]
HIGHLEVEL_NEW_LEAD_STAGE_ID=
# Pipeline stage a booked job moves to. Unset: the built-in EGC scheduled stage. [plain; Cloudflare Pages variable]
HIGHLEVEL_SCHEDULED_STAGE_ID=
# Pipeline stage after a completed walkthrough/quote. Unset: the built-in EGC walkthrough-complete stage. [plain; Cloudflare Pages variable]
HIGHLEVEL_QUOTED_STAGE_ID=
# Pipeline stage after a completed job. Unset: the built-in EGC job-complete stage. [plain; Cloudflare Pages variable]
HIGHLEVEL_COMPLETE_STAGE_ID=
# Comma-separated contact tags added while a quote is open. Unset: egc-quote-ready,gc-quote-open. [plain; Cloudflare Pages variable]
HIGHLEVEL_QUOTE_READY_TAGS=
# ISO instant; the Hub lead view ignores opportunities created before it. Unset or invalid: 2026-09-03T21:51:19.314Z. [plain; Cloudflare Pages variable]
HIGHLEVEL_LEADS_RESET_AT=
# Exactly "true" turns on the approved-send messaging service (/api/messages, owner-approved templates, message_sends ledger). Unset: messaging endpoints report not enabled and nothing is sent. [plain; Cloudflare Pages variable]
EGC_MESSAGING_ENABLED=
# Delivery switch for the messaging service: only exactly "false" sends through HighLevel; anything else records dry_run ledger entries with no provider call. Unset: dry run. [plain; Cloudflare Pages variable]
EGC_MESSAGING_DRY_RUN=
# Worker subrequest budget per /api/messages call (integer 30-9500; keep under the plan limit: 50 Free, 1000 Paid). Unset or out of range: 45. [plain; Cloudflare Pages variable]
EGC_MESSAGING_SUBREQUEST_BUDGET=
# Exactly "true" lets the signed messaging cron (/api/messaging-cron from the Railway worker) send day-before, deposit, payment and estimate-expiring reminders plus portal-invitation retries through the approved-send core, and stops the Hub triggering them from a manager's page load. Unset: the legacy browser triggers run and the cron accepts dry runs only. [plain; Cloudflare Pages variable]
EGC_SERVER_MESSAGING_ENABLED=
# Exactly "true" lets EGC staff email business hub member invitations through the approved-send core (b2b_invite; also needs messaging on, dry run off and owner-approved wording). Unset: invitations are private links staff or client admins deliver themselves. [plain; Cloudflare Pages variable]
BUSINESS_HUB_INVITE_DELIVERY=

# ── Unified operations bridge (Hub ↔ Railway egc-api) ─────────────────────
# See egc-platform/docs/railway-deployment.md "Employee Hub activation".

# An empty value is NOT the same as unset for the next variable and EGC_OPERATIONS_INBOUND_REPLY_MINUTES; keep them commented out unless you set a value.
# "false" turns off the Hub operations bridge (/api/operations*, recordings, schedule and note sync); "true" also allows it under legacy auth. Unset: on only when v2 service auth is active; any other value, even empty, is off. [plain; Cloudflare Pages variable]
# EGC_OPERATIONS_ENABLED=
# Bridge signing: "v2" (Ed25519 keys derived from HUB_SESSION_SECRET) or "legacy" (HMAC with EGC_OPERATIONS_PORTAL_SIGNING_SECRET). Unset: v2 when HUB_SESSION_SECRET is 32+ chars, else legacy; other values fail closed. [plain; Cloudflare Pages variable]
EGC_OPERATIONS_SERVICE_AUTH=
# Workspace stamped on bridge actors and required on inbound envelopes; must match Railway. Unset: egc. [plain; Cloudflare Pages variable]
EGC_OPERATIONS_WORKSPACE=egc
# HTTPS origin of Railway egc-api with no path (v2 accepts only the pinned production API origin). Unset: v2 uses the pinned origin; legacy bridge calls fail. [plain; Cloudflare Pages variable]
EGC_OPERATIONS_API_ORIGIN=
# Legacy HMAC key for Hub↔API envelopes; identical value on Railway egc-api. Unset: legacy bridge calls fail closed (v2 does not use it). [secret; Cloudflare Pages secret + Railway egc-api]
EGC_OPERATIONS_PORTAL_SIGNING_SECRET=
# Exactly "true" lets the Railway egc-api schedule-sync loop read the Hub's due HighLevel calendar mirrors (schedule.sync_due, which also records the loop's check-in; it scans operations-owned rows through the jobs providerSyncOwner+syncStatus index in firestore.indexes.json, so deploy that index first, otherwise the command fails closed and page loads keep retrying) and record failures with backoff (schedule.sync_failed; the loop counts its own attempts apart from the page's and parks a visit after 8 of its failures on one schedule change, or at once when the appointment ledger refuses the key outright (appointment_idempotency_payload_conflict, appointment_changed_since_acceptance); a parked visit shows "Sync needs review" whoever failed last, and a manager's Retry or Retry all clears the park so the loop starts a fresh budget, as does a new schedule change); manager page loads stop auto-retrying those operations-owned visits only while the loop has checked in within 10 minutes, so with the egc-api loop off or broken they keep retrying as today and ignore the loop's backoff. The Retry buttons stay available in every mode and sync under the visit's own key, which neither the loop nor MCP uses. Unset: both commands answer schedule_sync_queue_disabled and page loads keep retrying as today. [plain; Cloudflare Pages variable]
EGC_SCHEDULE_SYNC_WORKER=
# Hub user id that owns unanswered inbound customer replies. Unset: the sole Hub owner, otherwise inbound follow-ups stay unresolved. [plain; Cloudflare Pages variable]
EGC_OPERATIONS_INBOUND_OWNER_ID=
# Exactly "true" makes portal.members/portal.rules and the Action Center owner list include configured business users' staffRoles plus configured users and approved employee accounts holding sales or phone roles (tagged businessAccess:false); if those accounts cannot be read, the Action Center keeps the business users assignable and says so. Unset: the business-user member list is unchanged. [plain; Cloudflare Pages variable]
EGC_OPERATIONS_STAFF_MEMBERS=
# owner, manager, sales or phone: the sole member holding this role owns inbound follow-ups (EGC_OPERATIONS_INBOUND_OWNER_ID still wins) and walkthrough/call follow-ups when neither the Hub settings nor EGC_OPERATIONS_FOLLOWUP_OWNER_ID name an owner. Unset: the sole authoritative owner, as today. [plain; Cloudflare Pages variable]
EGC_OPERATIONS_FOLLOWUP_ROLE=
# Exactly "true" adds the P3-04 follow-up policy (owner, due minutes, Denver send window) to portal.rules, read from the owner's Hub settings (operations_settings/followups). Unset: portal.rules is unchanged and no settings are read. [plain; Cloudflare Pages variable]
EGC_OPERATIONS_FOLLOWUP_POLICY_ENABLED=
# Hub user id (an active owner, manager, sales or phone member) that owns walkthrough and call follow-ups when the Hub settings name no owner; it wins over EGC_OPERATIONS_FOLLOWUP_ROLE. Unset: the settings owner, else the sole EGC_OPERATIONS_FOLLOWUP_ROLE member, else follow-ups stay unresolved. [plain; Cloudflare Pages variable]
EGC_OPERATIONS_FOLLOWUP_OWNER_ID=
# Operations bridge: JSON map from an integration principal id (e.g. "mcp-oauth-grant:<id>") to the Hub username it may act for in read-only hub.* bridge commands; that user must be a current business user with an owner, manager or sales role. A malformed value fails closed with 503 hub_delegate_config_invalid for integration callers only. Unset: no delegations; integration callers cannot use hub.* commands. [plain; Cloudflare Pages variable]
EGC_OPERATIONS_HUB_DELEGATES_JSON=
# Exactly "true" makes destructive legacy bridge commands (a visit cancellation through schedule.mutate) carry a single-use SEC-03 confirmation token bound to the caller and the exact change; the API and MCP cannot issue one yet, so turning this on blocks bridge cancellations (cancel in Hub dispatch instead). Unset: cancellations run without a token as before; a token that is sent is still verified and consumed. [plain; Cloudflare Pages variable]
EGC_OPERATIONS_BRIDGE_CONFIRM_REQUIRED=
# Minutes until an unanswered inbound reply is due (integer 5–10080). Unset: 60; an invalid or empty value disables the rule. [plain; Cloudflare Pages variable]
# EGC_OPERATIONS_INBOUND_REPLY_MINUTES=

# ── AI assistant (MCP) connections approved in the Employee Hub ────────────
# /api/mcp-grant shows the approval page for "Continue with Employee Hub" (MCP-OAUTH).

# Bare https origin of the Railway egc-mcp server (e.g. https://mcp.easygaragecleaning.com) whose OAuth grants /api/mcp-grant approves; also needs signed service keys (v2). Unset: /api/mcp-grant answers "Connections are off" (503) and approves nothing. [plain; Cloudflare Pages variable]
EGC_MCP_PUBLIC_ORIGIN=

# ── Workflow webhooks (Zapier) — private URLs never appear in browser source ─

# Zapier Catch Hook for the crew tools (/api/crew-hook); rotate it in Zapier, the original shipped in client source. Unset: crew hook calls return 501. [secret; Cloudflare Pages secret]
CREW_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
# /api/operations-event destination for quote_followup events. Unset: that event returns 501 and the automations badge shows not ready. [secret; Cloudflare Pages secret]
QUOTE_FOLLOWUP_WEBHOOK_URL=
# /api/operations-event destination for booking events. Unset: that event returns 501 and the automations badge shows not ready. [secret; Cloudflare Pages secret]
BOOKING_WEBHOOK_URL=
# /api/operations-event destination for review_request events (sends an SMS downstream). Unset: that event returns 501 and the automations badge shows not ready. [secret; Cloudflare Pages secret]
REVIEW_WEBHOOK_URL=
# /api/operations-event destination for meta_signal conversion events. Unset: that event returns 501 and the automations badge shows not ready. [secret; Cloudflare Pages secret]
META_SIGNAL_WEBHOOK_URL=
# Zapier Catch Hook that /api/web-lead relays SMS-consented website leads to. Unset: leads still sync to HighLevel with no relay. [secret; Cloudflare Pages secret]
WEBSITE_LEAD_HOOK_URL=
# Exactly "true" records every website lead in the server-only web_lead_receipts ledger (sealed payload, inquiry.received funnel event) before the HighLevel sync, and retries failed syncs (at least once) on the signed messaging cron outside Denver quiet hours. Nothing in HighLevel needs changing: a retried sync makes the same contact, tag and note calls as an on-time one (its detail note says it came late), so a lead synced late (after a HighLevel outage, up to about 45 hours) starts the HighLevel automations late, exactly as if it had just arrived; a retry never sends the Zapier text, and never creates or moves an opportunity for a contact that already existed or reopens a closed one. A sealed lead kept on an abandoned receipt is deleted after 30 days (set HUB_PURPOSE_KEY_SECRET first). Unset: leads sync to HighLevel directly and a failed sync is only in the Web3Forms email, as before. [plain; Cloudflare Pages variable]
WEB_LEAD_RECEIPTS_ENABLED=
# Optional extra for WEB_LEAD_RECEIPTS_ENABLED, needed only if the owner chooses to add HighLevel workflow filters: exactly "true" makes a late (retried) sync first add the tag egc-delayed-sync with its own call, and an on-time website lead of an existing contact remove it again, so website-lead instant-reply workflows can skip a reply that would now arrive late (docs/FUNNEL-METRICS.md FUN-13 owner checklist; remove those filters before turning it off again, since nothing removes the tag then). Unset: no call adds or removes the tag, a late sync reaches HighLevel exactly as an on-time one does, and nothing in HighLevel needs changing. [plain; Cloudflare Pages variable]
WEB_LEAD_DELAYED_SYNC_TAG=
# Exactly "true" lets ads landing page leads sync to HighLevel and the Zapier text relay like every other website form (turn on only after the HighLevel and Zapier automations they would start are approved). Unset: ads page leads are receipted (with WEB_LEAD_RECEIPTS_ENABLED) but not synced or texted, and arrive only by the Web3Forms email as before. [plain; Cloudflare Pages variable]
WEB_LEAD_ADS_RELAY_ENABLED=

# ── Server-side booking confirmation email ────────────────────────────────
# The browser never receives these identifiers; /api/email-confirmation derives
# the recipient from the saved job.

# EmailJS service id for the booking confirmation email. Unset: confirmation email returns 501. [plain; Cloudflare Pages variable]
EMAILJS_SERVICE_ID=
# EmailJS template id for the booking confirmation email. Unset: confirmation email returns 501. [plain; Cloudflare Pages variable]
EMAILJS_TEMPLATE_ID=
# EmailJS public key (user_id) for the booking confirmation email. Unset: confirmation email returns 501. [plain; Cloudflare Pages variable]
EMAILJS_PUBLIC_KEY=

# ── Quo business texting (crew plan sender, /api/quo-send) ─────────────────

# Quo (OpenPhone) API key sent verbatim as the Authorization header. Unset: /api/quo-send returns 501. [secret; Cloudflare Pages secret]
QUO_API_KEY=
# Quo number texts are sent from. Unset: +19709991818. [plain; Cloudflare Pages variable]
QUO_FROM=+19709991818
# Quo API base URL, for when Quo moves the host. Unset: https://api.openphone.com/v1. [plain; Cloudflare Pages variable]
QUO_API_BASE=

# ── OpenAI (Field Co-Pilot and "Generate the After") ──────────────────────
# Set this exact lowercase name in BOTH Production and Preview. OPENAI_API_KEY
# only satisfies the integration-status badge; the features read openaiapi.
# Get it at: https://platform.openai.com/api-keys
# OpenAI key for /api/copilot and /api/garage-render (name match tolerates case and spaces). Unset: both return "openaiapi missing". [secret; Cloudflare Pages secret]
openaiapi=sk-...

# ── Jobber customer lookup ────────────────────────────────────────────────
# Create an app at developer.getjobber.com (scope: read_clients, refresh
# rotation OFF, redirect https://easygaragecleaning.com/api/jobber-auth),
# then visit /api/jobber-auth once to mint the refresh token.

# Jobber app client id for /api/jobber-auth, /api/jobber-clients and /api/jobber-requests. Unset: Jobber lookups report not configured. [plain; Cloudflare Pages variable]
JOBBER_CLIENT_ID=
# Jobber app client secret. Unset: Jobber lookups report not configured. [secret; Cloudflare Pages secret]
JOBBER_CLIENT_SECRET=
# Refresh token minted once through /api/jobber-auth (which then returns 404). Unset: lookups report not configured and /api/jobber-auth stays open for consent. [secret; Cloudflare Pages secret]
JOBBER_REFRESH_TOKEN=
# Exactly "true" turns on the FUN-32 booking guard: from the Jobber cutover day (jobber.cutoverDate in the funnel definitions) on, /api/crew-hook refuses signed game plans, whose Zap branch creates a Jobber job. Unset: game plans are forwarded as today. [plain; Cloudflare Pages variable]
EGC_JOBBER_GUARD_BOOKING=
# Exactly "true" turns on the FUN-32 billing guard: from the Jobber cutover day on, /api/money refuses invoice.issue and the messaging cron holds deposit and payment reminders while the saved Jobber guard check (scripts/jobber-guard.mjs --save) shows an open Jobber bill for the customer or a Jobber-settled imported balance for the job. Unset: no billing holds. [plain; Cloudflare Pages variable]
EGC_JOBBER_GUARD_BILLING=
# Exactly "true" turns on the FUN-32 messaging guard: from the Jobber cutover day on, the messaging cron holds automatic customer reminders while the saved Jobber guard check shows open Jobber work or an open Jobber invoice that Jobber may message the customer about. Unset: no messaging holds. [plain; Cloudflare Pages variable]
EGC_JOBBER_GUARD_MESSAGING=

# ── Google Drive uploads (job photos, field photos, agreements) ───────────
# Google Cloud Console → OAuth client (Web), redirect
# https://easygaragecleaning.com/api/drive-auth, consent screen published.
# Scope is drive.file — the app can only touch folders/files it created.

# Google OAuth client id for Drive uploads. Unset: Drive uploads report not configured. [plain; Cloudflare Pages variable]
GOOGLE_CLIENT_ID=
# Google OAuth client secret. Unset: Drive uploads report not configured. [secret; Cloudflare Pages secret]
GOOGLE_CLIENT_SECRET=
# Refresh token minted once through /api/drive-auth while signed into the EGC Google account (the route then returns 404). Unset: uploads report not configured. [secret; Cloudflare Pages secret]
GOOGLE_REFRESH_TOKEN=

# ── Stripe (Garage Guard memberships, deposits, job payments) ─────────────
# Keys: dashboard.stripe.com → Developers. The SECRET key stays server-side.
# Webhook: Developers → Webhooks → endpoint https://easygaragecleaning.com/api/stripe-webhook
# with checkout.session.completed, checkout.session.async_payment_succeeded,
# invoice.paid, invoice.payment_failed and customer.subscription.deleted,
# then copy its signing secret.

# Stripe secret key (sk_live_/sk_test_) for Garage Guard checkout/portal, deposits and job payments; /api/stripe-webhook also reads each deposit and job payment back from Stripe, with its charge and any refund, before recording it. Unset: payment endpoints report Stripe not configured and those webhook deliveries return 503 so Stripe retries. [secret; Cloudflare Pages secret]
STRIPE_SECRET_KEY=sk_live_...
# Signing secret that verifies /api/stripe-webhook deliveries. Unset: webhooks return 503 so Stripe retries. [secret; Cloudflare Pages secret]
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe customer-portal login link (https://billing.stripe.com/...) for returning members; enable at Settings → Billing → Customer portal. Unset: no login link is shown. [plain; Cloudflare Pages variable]
STRIPE_PORTAL_LOGIN_URL=https://billing.stripe.com/p/login/...
# Stripe Price id for Guard Lite. Unset: checkout uses the inline $450/year price. [plain; Cloudflare Pages variable]
STRIPE_PRICE_GUARD_LITE=
# Stripe Price id for Garage Guard. Unset: checkout uses the inline $800/year price. [plain; Cloudflare Pages variable]
STRIPE_PRICE_GUARD=
# Stripe Price id for Guard Black. Unset: checkout uses the inline $2,500/year price. [plain; Cloudflare Pages variable]
STRIPE_PRICE_GUARD_BLACK=
# Exactly "true" counts a completed Garage Guard member visit (a job with membershipId) against its membership right after the field completion: memberships/ visitsRemaining minus one, the visit's allocated revenue (plan price paid / included visits) and membership.visit_used, mirrored onto the account job, and lets managers do the same with visit.apply on POST /api/garage-guard-members. The Stripe webhook also records it on each billing period, so only a period tracked throughout reports visits used, utilization, visit and recognized revenue, deferred revenue and breakage. Unset: completions only record membershipVisit pending, visit counts stay as managers set them, and those amounts are reported as unknown (null) for every range a member's year overlaps, not only when a year closes. [plain; Cloudflare Pages variable]
GARAGE_GUARD_VISIT_TRACKING_ENABLED=
# Zapier Catch Hook for team alerts on new members, failed renewals and cancellations. Unset: webhook events are verified and acknowledged but not forwarded. [secret; Cloudflare Pages secret]
GARAGE_GUARD_HOOK_URL=
# Exactly "true" records Garage Guard Stripe events once per event id in memberships/, links members to a Hub customer only by exact phone/email (otherwise membership_reviews, listed at GET /api/stripe-reviews) and mirrors garageGuard onto the account job. Unset: off; the Zapier relay stays exactly as before. [plain; Cloudflare Pages variable]
GARAGE_GUARD_MEMBERSHIP_SYNC_ENABLED=
# Exactly "true" refuses a new crew card link or customer portal checkout (409 payment_review_open) while the job has an open payment_reviews record, until a manager resolves it in Hub > Review queues. Unset: checkouts open as today even when a confirmed charge is held for review. [plain; Cloudflare Pages variable]
PAYMENT_REVIEW_CHECKOUT_BLOCK_ENABLED=

# ── Money documents and money API ─────────────────────────────────────────

# Exactly "true" turns on GET /api/money-document (server-rendered estimate, invoice and receipt pages for staff and the job's own portal session), the portal document links and the Hub print hand-off. Unset: the endpoint is off, the portal lists no documents and the Hub prints its legacy copy. [plain; Cloudflare Pages variable]
MONEY_DOCUMENT_ENABLED=
# Exactly "true" turns on server money writes at /api/money (estimates, approvals, offline deposits/payments into the payment ledger, invoice issue/void) and hands the Hub finance buttons to them; run scripts/backfill-payment-ledger.mjs first. Unset: the Hub keeps today's browser finance tools. [plain; Cloudflare Pages variable]
MONEY_API_ENABLED=
# Exactly "true", together with MONEY_API_ENABLED="true", bills a priced crew decision the customer approves in the portal while the job is open, the crew is still on it and the question is at most 14 days old: the approval adds a change-order line (kind fee), which the portal balance, Stripe checkout and recording, crew closeout and card-link limits, payment reminders and an issued invoice include while the deposit stays on the quote (the Hub finance board shows it once an invoice is issued); after turning it on, review the dry run of scripts/backfill-change-orders.mjs (it also lists jobs whose saved approved-change total their decisions and lines do not explain, stored_total_mismatch, for the owner to correct) and then run it with --apply --billing-enabled. Every saved line stays billed whatever this flag says: the rollback for a line is the Hub money action change_order.void, never turning the flag off. Whatever the flag, portal decision answers are replay safe (a request id, retried reads, 503 when an answer cannot be confirmed, 409 CUSTOMER_PORTAL_IDEMPOTENCY_CONFLICT for a reused id), return only the portal view of the decision, and a question that already has a saved line cannot be answered again. Unset: new approvals are saved but not added to what is charged, as today (also while MONEY_API_ENABLED is unset); lines saved while it was on stay billed until voided. [plain; Cloudflare Pages variable]
CHANGE_ORDER_BILLING_ENABLED=

# ── Gusto (one-way approved EGC shifts to Gusto Time Tracking) ────────────
# Requires an approved Gusto App Integration; a regular payroll login is not
# API authorization. See docs/gusto-sync.md. OAuth tokens are stored encrypted
# with the EXISTING employee vault key in server-only Firestore
# gusto_integrations — preserve that key across deploys.

# Gusto API environment, exactly "demo" or "production". Unset: Gusto sync reports not configured. [plain; Cloudflare Pages variable]
GUSTO_ENVIRONMENT=
# Gusto App Integration client id. Unset: Gusto sync reports not configured. [plain; Cloudflare Pages variable]
GUSTO_CLIENT_ID=
# Gusto App Integration client secret. Unset: Gusto sync reports not configured. [secret; Cloudflare Pages secret]
GUSTO_CLIENT_SECRET=
# Gusto company UUID the sync is locked to. Unset: Gusto sync reports not configured. [plain; Cloudflare Pages variable]
GUSTO_COMPANY_UUID=
# OAuth redirect; production must be exactly this URL (demo also allows localhost /api/gusto-auth). Unset: Gusto sync reports not configured. [plain; Cloudflare Pages variable]
GUSTO_REDIRECT_URI=https://easygaragecleaning.com/api/gusto-auth
# Exactly "true" only after Gusto approves production access. Unset: the production environment stays blocked. [plain; Cloudflare Pages variable]
GUSTO_PRODUCTION_APPROVED=false

# ── Timesheets and payroll export ─────────────────────────────────────────

# Overtime rules for /api/timesheets (payroll CSV) and /api/job-costing: colorado (COMPS: 1.5x over 40/week, 12/workday or 12 consecutive hours, whichever pays more) or federal (FLSA weekly only); any other value makes both endpoints refuse with 503 timesheet_policy_invalid. Unset: colorado. [plain; Cloudflare Pages variable]
EGC_OVERTIME_POLICY=

# ── Garage catalog and pricing ────────────────────────────────────────────

# Exactly "true" turns on /api/catalog: owner and managers read the published garage catalog priced with the saved pricing settings (the seed catalog and placeholder settings until the owner saves or publishes), and only the owner saves settings or publishes a catalog version. Unset: GET /api/catalog answers enabled:false with no data and every write is 404. [plain; Cloudflare Pages variable]
CATALOG_QUOTES_ENABLED=

# ── QuickBooks (readiness badge only) ─────────────────────────────────────

# Shown only as a readiness badge by /api/integration-status; no QuickBooks integration reads it yet. Unset: the badge shows not configured. [plain; Cloudflare Pages variable]
QUICKBOOKS_CLIENT_ID=
# Shown only as a readiness badge by /api/integration-status; no QuickBooks integration reads it yet. Unset: the badge shows not configured. [secret; Cloudflare Pages secret]
QUICKBOOKS_CLIENT_SECRET=

# ── Dispatch scheduling ───────────────────────────────────────────────────

# Exactly "true" gives scheduled jobs saved without an explicit arrival window a derived one from the start time (labels are saved with the job; preview/apply future jobs with node scripts/backfill-arrival-windows.mjs then --apply). Unset: only manager-set windows show. [plain; Cloudflare Pages variable]
EGC_DISPATCH_DEFAULT_ARRIVAL_WINDOW_ENABLED=false
# Length in minutes of the derived arrival window (15-480). Unset or out of range: 60. [plain; Cloudflare Pages variable]
EGC_DISPATCH_DEFAULT_ARRIVAL_WINDOW_MINUTES=60
# Legacy blocked_days handling: off, warn (openings skip the day and placing work warns) or enforce (placing work or picking up a shift that day is a 409). Unset or unknown: off, blocked_days are not read. [plain; Cloudflare Pages variable]
EGC_DISPATCH_LEGACY_BLOCKED_DAYS=
# Drive-time estimates for dispatch warnings, openings and GET /api/dispatch-travel: off, offline (built-in Northern Colorado ZIP table; no key, no network, recommended) or google (Distance Matrix via GOOGLE_MAPS_SERVER_API_KEY, falls back to offline); estimates only ever raise the manual buffer. Unset or unknown: off, manual travel buffers only. [plain; Cloudflare Pages variable]
EGC_DISPATCH_TRAVEL_ESTIMATES=
# Server-only Google Maps key restricted to the Distance Matrix API, used only when EGC_DISPATCH_TRAVEL_ESTIMATES=google (job addresses are sent to Google; max 25 calls per request, 30-day hashed cache). Unset: google mode downgrades to offline. [secret; Cloudflare Pages secret]
GOOGLE_MAPS_SERVER_API_KEY=
# Exactly "true" (with estimates on) makes a save that moves a stop into a gap shorter than the estimated drive a 409 dispatch_conflict; manual-buffer shortfalls stay warnings. Unset: drive shortfalls are warnings only. [plain; Cloudflare Pages variable]
EGC_DISPATCH_BLOCK_TRAVEL_SHORT=
# Exactly "true" lets dispatch managers save assignment segments (multi-crew jobs, split crews, per-day work windows); saved segments are always honoured and can be cleared when off. Unset: the assignmentSegments field is rejected and dispatch saves behave as before. [plain; Cloudflare Pages variable]
EGC_DISPATCH_SEGMENTS=
# Scale reads for dispatch: "shadow" still answers from full collection scans but also runs the windowed jobs queries, the save lookups and the indexed customer search and logs any difference (dispatch_window_shadow, dispatch_save_query_shadow and dispatch_customer_search_shadow lines); exactly "true" makes the board, job view, save and shift-claim conflict checks, openings and drive-time routes read only jobs ending within 35 days before the viewed dates or later, plus undated and time-off rows, saves look up a customer's or walkthrough's jobs by exact match, and customer search use searchKeys while every customer has current keys (preview with node scripts/backfill-customer-search-keys.mjs, then --apply; audit with node scripts/dispatch-window-audit.mjs). Unset: every dispatch read scans the complete jobs and customers collections as before. [plain; Cloudflare Pages variable]
EGC_DISPATCH_WINDOWED_READS=
# Exactly "true" enables server recurring plans (create, update, resume and extend via /api/recurring-plans and Dispatch > Recurring plans; the booking wizard's repeating series becomes a server plan; runRecurringHorizon works). Keep it unset until the horizon job (P1-DS-11) runs. Unset: legacy fixed-count series; existing plans can still be listed, paused or ended. [plain; Cloudflare Pages variable]
EGC_RECURRING_PLANS_ENABLED=

# ── Crew field execution ──────────────────────────────────────────────────

# Exactly "true" turns on field cost capture: /api/field-expenses (materials, dump fees, subcontractors, fuel, damage claims, other and recovery income, with who paid, shared-load splits and the closeout "None" taps; integer cents up to $5,000, optional Drive receipt photo) and the Job costs card on /crew/job.html. Unset: the endpoint returns 404 FIELD_EXPENSES_DISABLED and the card stays hidden. [plain; Cloudflare Pages variable]
FIELD_EXPENSES_ENABLED=
# Exactly "true" (with FIELD_EXPENSES_ENABLED on) blocks field job completion with 409 FIELD_COMPLETION_INCOMPLETE until materials and dump fees are each recorded or marked "None" in Job costs, and lists them in the job's completion checklist. Unset: the Job costs closeout is a record-only prompt and completion is never blocked. [plain; Cloudflare Pages variable]
FIELD_EXPENSE_CLOSEOUT_REQUIRED=
# Exactly "true" turns on multi-day visits in /api/field-jobs and /crew/job.html: a per-day visit record (fieldExecution.visits), the end_day action (notes required; stops the job clock for the day, queueable offline; one synced after Denver midnight closes the day it was saved for and flags the job clock for review), completion of a multi-day job only on its final Denver day unless a manager gives a reason, and crew writes (including /api/field-expenses job costs) on split (segmented) jobs only on days they have a segment. Unset: no visit records or end_day action, completion on any day, no per-day write check. [plain; Cloudflare Pages variable]
FIELD_MULTIDAY_VISITS=
# "true" lets crew clock actions queued offline keep the phone's capture time (at most 12 h old, at most 2 min ahead of the server, not before the shift's last event) and flags the timecard deviceTime/needsReview; keep it off until the Hub timesheet shows a review badge and action. Unset: server time only, and an offline clock action more than 2 minutes old is refused with 409 EMPLOYEE_TIMECARD_DEVICE_TIME. [plain; Cloudflare Pages variable]
EGC_OFFLINE_CLOCK_ENABLED=
# Exactly "true" accepts walkthrough Start/Finish/No-show on POST /api/walkthrough-visit (sales, manager, owner): it records walkthroughVisit/walkthroughOutcome with funnel events and opens/closes the rep's timecard work segment on the visit (offline device times follow EGC_OFFLINE_CLOCK_ENABLED); turn on with the FUN-06 recorder. Unset: POST returns 503 walkthrough_visit_disabled and GET reports enabled:false. [plain; Cloudflare Pages variable]
EGC_WALKTHROUGH_VISIT_ENABLED=
# Exactly "true" shows verified before/after field photos in the customer portal (streamed by /api/customer-portal-photo after a session check) and lets owners/managers share or hide individual photos via /api/field-photo-sharing. Unset: the portal omits beforeAfter and both endpoints return 404. [plain; Cloudflare Pages variable]
FIELD_CUSTOMER_PHOTOS_ENABLED=
# Denver date (YYYY-MM-DD): only before/after photos added on or after it show automatically on completed jobs; older ones show only when a manager shares them (an unreadable value shows manager-shared photos only). Unset: every verified before/after photo on a completed job shows. [plain; Cloudflare Pages variable]
FIELD_CUSTOMER_PHOTOS_SINCE=
# Exactly "true" shows the crew assigned to a job in the customer portal (first name, manager-approved photo via a signed, session-checked /api/customer-crew-photo link, crew lead first) plus an "on the way" note while the crew is en route on the service day (dropped 12 h after departure); only profiles a manager marked shown at /crew/profile-photo appear. Unset: the portal DTO keeps its current shape and the photo proxy returns 404 (staff can still prepare profiles). [plain; Cloudflare Pages variable]
CREW_PUBLIC_PROFILES_ENABLED=
# Exactly "true" lets only the job's crew lead (or an owner/manager) complete a job and send its "on my way" message: other assigned crew get 403 FIELD_LEAD_REQUIRED (completion) or messaging_forbidden (on my way) and the job page hides the completion form; a job with no named lead is led by its only crew member or an assigned crew_lead. Unset: every assigned crew member can complete and send "on my way", as before. [plain; Cloudflare Pages variable]
FIELD_LEAD_ONLY_COMPLETE=
