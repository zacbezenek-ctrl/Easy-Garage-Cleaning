# Copy this file to `.env` (or `.dev.vars` for local Cloudflare Pages dev)
# Never commit the filled-in version — .env and .dev.vars are gitignored.

# OpenAI API key — used by /functions/api/copilot.js (Field Co-Pilot) and
# /functions/api/garage-render.js ("Generate the After" in the crew Game Plan).
# Set this in BOTH the Production AND Preview environments in the Cloudflare
# Pages dashboard, or "Generate the After" returns "openaiapi missing".
# Get it at: https://platform.openai.com/api-keys
openaiapi=sk-...

# Firebase Web API key — public client configuration used by Firebase Auth.
# Find it at: Firebase Console → Project settings → General → Web API Key.
FIREBASE_API_KEY=AIzaSyA8g4UAW4P4bsCrQNZhUe81CbC7BvjJbNc

# Dedicated random signing key for staff and customer HttpOnly sessions.
# Generate at least 32 random bytes and store it as a Cloudflare encrypted secret.
# Never reuse a CRM, Firebase, Stripe, or webhook credential here.
HUB_SESSION_SECRET=

# Built-in Hub accounts belong in an encrypted secret, never in repository code.
# Values may be records with passwordHash, displayName, role, payType, and hourlyRate.
HUB_AUTH_USERS_JSON={"Owner":{"passwordHash":"<generated-hash>","displayName":"Owner","role":"owner","payType":"owner","hourlyRate":0}}

# Optional separation for encrypted employee records and customer portal links.
# If omitted, these safely use HUB_SESSION_SECRET.
EMPLOYEE_HUB_DATA_SECRET=
CUSTOMER_PORTAL_SECRET=

# Server-only Firebase service account. Required for authenticated Firestore
# REST calls and short-lived employee Firebase custom tokens. Store the whole
# downloaded JSON object as a Cloudflare encrypted secret; never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"egcw-1ec83",...}

# Zapier Catch Hook for the crew tools — used by /functions/api/crew-hook.js
# Rotate the hook in Zapier and paste the fresh URL here (the original shipped
# in client source and is burned).
CREW_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# Employee-hub workflow destinations — used by /api/operations-event so no
# private webhook URL appears in public browser source.
QUOTE_FOLLOWUP_WEBHOOK_URL=
BOOKING_WEBHOOK_URL=
REVIEW_WEBHOOK_URL=
META_SIGNAL_WEBHOOK_URL=
WEBSITE_LEAD_HOOK_URL=

# Server-side booking confirmation email. The browser never receives these
# identifiers; /api/email-confirmation derives the recipient from the saved job.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Quo business-text integration used by the crew plan sender.
QUO_API_KEY=
QUO_FROM=+19709991818

# Jobber customer lookup — used by /functions/api/jobber-clients.js
# Create an app at developer.getjobber.com (scope: read_clients, refresh
# rotation OFF, redirect https://easygaragecleaning.com/api/jobber-auth),
# then visit /api/jobber-auth once to mint the refresh token.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REFRESH_TOKEN=

# Google Drive job-photo upload — used by /functions/api/drive-upload.js
# Google Cloud Console → OAuth client (Web), redirect
# https://easygaragecleaning.com/api/drive-auth, consent screen published.
# Then visit /api/drive-auth once (signed into the EGC Google account).
# Scope is drive.file — the app can only touch folders/files it created.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Stripe — Garage Guard memberships (/garage-guard.html)
# Used by /functions/api/garage-guard-checkout.js, garage-guard-portal.js,
# and stripe-webhook.js. Get keys at: dashboard.stripe.com → Developers.
# The SECRET key stays server-side only — it must never appear in any HTML/JS.
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret — Dashboard → Developers → Webhooks → add endpoint
# https://easygaragecleaning.com/api/stripe-webhook with events
# checkout.session.completed, invoice.payment_failed,
# customer.subscription.deleted — then copy its whsec_... here.
STRIPE_WEBHOOK_SECRET=whsec_...
# Customer portal login link (returning members manage/cancel their plan;
# Stripe verifies them by emailed one-time code). Enable at: Dashboard →
# Settings → Billing → Customer portal → "Launch customer portal with a link".
STRIPE_PORTAL_LOGIN_URL=https://billing.stripe.com/p/login/...
# Optional: dashboard Price IDs for the three tiers. If unset, checkout still
# works — sessions are created with inline prices ($450/$800/$2,500 per year).
STRIPE_PRICE_GUARD_LITE=
STRIPE_PRICE_GUARD=
STRIPE_PRICE_GUARD_BLACK=
# Optional: Zapier Catch Hook for team SMS alerts on new members / failed
# renewals / cancellations (same pattern as CREW_WEBHOOK_URL).
GARAGE_GUARD_HOOK_URL=

# For PRODUCTION, set ALL variables in:
#   Cloudflare Dashboard → Pages → <project> → Settings → Environment variables
# Do NOT rely on the local .env in production — Pages Functions only read CF env vars.
