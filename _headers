# Cloudflare Pages headers
# Public assets are versioned in markup. Cache them for repeat visits and let
# Cloudflare serve them without a round trip to origin.
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/garage-turnaround.css
  Cache-Control: public, max-age=31536000, immutable

/analytics-loader.js
  Cache-Control: public, max-age=31536000, immutable

/site-enhancements.js
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

# Internal crew tooling — never index, never cache an old build in the field
/crew/*
  X-Robots-Tag: noindex
  Cache-Control: no-cache
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Internal operations hub — never index, frame, or keep a stale application shell.
/employee*
  X-Robots-Tag: noindex
  Cache-Control: no-store
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Other private staff/customer workflow shells.
/copilot*
  X-Robots-Tag: noindex
  Cache-Control: no-store
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/quote*
  X-Robots-Tag: noindex
  Cache-Control: no-store
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/tyler-contract*
  X-Robots-Tag: noindex
  Cache-Control: no-store
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Lead-attribution + relay script — must update instantly on deploy, or the
# form silently stops mirroring leads to HighLevel/Zapier. Revalidate every load (cheap
# ETag check) instead of the default 4h cache. Bump the ?v= tag in the <script>
# refs for an immediate bust of already-cached copies.
/fb-capture.js
  Cache-Control: no-cache

# Garage Guard membership page — hardens the page that starts Stripe checkout:
# no framing (blocks clickjacking a Join button inside an invisible iframe),
# no MIME sniffing, and never serve a stale build of a payments page.
/garage-guard.html
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-cache

# Same protections for the extensionless path Cloudflare actually serves
/garage-guard
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-cache
