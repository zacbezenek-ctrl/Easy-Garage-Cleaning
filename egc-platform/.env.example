NODE_ENV=development

# HTTP
API_PORT=4100
MCP_PORT=4200
PORTAL_PORT=4300
API_URL=http://localhost:4100
MCP_URL=http://localhost:4200/mcp

# Internal service authentication. Use random 32+ byte values in deployment secrets.
API_BEARER_TOKEN=
# Optional diagnostic/service bearer. ChatGPT uses OAuth, not this token.
MCP_BEARER_TOKEN=
MCP_ALLOWED_HOSTS=

# ChatGPT MCP OAuth
# Production example: https://mcp.easygaragecleaning.com
MCP_PUBLIC_ORIGIN=
MCP_OAUTH_USER=
# Use a random 20+ character password.
MCP_OAUTH_PASSWORD=

# Internal portal browser authentication
PORTAL_BASIC_USER=
PORTAL_BASIC_PASSWORD=

# Postgres
DATABASE_URL=postgres://egc:egc@localhost:5432/egc

# Optional until a queue-backed worker is introduced
REDIS_URL=

# GoHighLevel
GHL_LOCATION_ID=
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_CLIENT_ID=6aad5ba75e77021cc14025b5-mu74tcuj
GHL_CLIENT_SECRET=
GHL_WRITEBACK_ENABLED=false

# OpenAI / voice walkthrough
OPENAI_API_KEY=

# Storage
# V1 Railway deployment can use filesystem + a persistent volume mounted at STORAGE_PATH.
STORAGE_DRIVER=filesystem
STORAGE_PATH=/data/egc

# Optional S3 / R2 configuration when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional
SENTRY_DSN=
