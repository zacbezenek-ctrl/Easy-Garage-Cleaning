# Environment for the Railway egc-platform services (egc-api, egc-mcp,
# egc-worker, egc-portal). Copy to `.env` for local development; never commit
# the filled-in version. In production set values per service in Railway →
# <service> → Variables (see docs/railway-deployment.md). Railway injects PORT
# and RAILWAY_GIT_COMMIT_SHA itself. Some settings below are commented out
# because code reads them with ?? and an empty value is not the same as unset:
# uncomment one only to give it a real value.
#
# Format (checked by tests/env-inventory.test.mjs at the repository root;
# `node scripts/env-inventory.mjs` lists every variable the code reads): each
# variable has ONE comment line directly above it — what it does, "Unset:"
# behaviour, then [secret|plain; Railway service(s)]. When code reads A ?? B,
# document A (B is a fallback). Never put real values here.

# Node environment; production requires MCP_PUBLIC_ORIGIN (https) and MCP_ALLOWED_HOSTS. Unset: development behaviour (the Dockerfiles set production). [plain; Railway all services via Dockerfile]
NODE_ENV=development
# Release commit reported by /health and MCP status when Railway's RAILWAY_GIT_COMMIT_SHA is absent; update it per release to trigger a source deploy. Unset: release reports null unless Railway provides its SHA. [plain; Railway egc-api, egc-mcp, egc-portal, egc-worker]
# EGC_RELEASE_SHA=

# ── HTTP (local development; Railway injects PORT) ─────────────────────────

# egc-api listen port when the runtime provides no PORT. Unset: 4100. [plain; local only]
API_PORT=4100
# egc-mcp listen port when the runtime provides no PORT. Unset: 4200. [plain; local only]
MCP_PORT=4200

# ── Internal service authentication (random 32+ byte values) ──────────────

# Bearer for protected egc-api routes and root of the v2 service-signing keys (32+ chars); set it on egc-worker only for the messaging cron, since the holder can sign any API-to-Hub service request. Unset: protected API routes answer api_auth_not_configured and v2 service auth is unavailable. [secret; Railway egc-api, egc-worker]
API_BEARER_TOKEN=
# Optional diagnostic bearer for internal MCP clients and the startup self-checks (32+ chars); ChatGPT uses OAuth instead. Unset: only OAuth tokens are accepted and startup verification cannot run. [secret; Railway egc-mcp]
MCP_BEARER_TOKEN=
# Comma-separated Host names the MCP accepts (DNS-rebinding guard). Unset: egc-mcp refuses to start in production. [plain; Railway egc-mcp]
MCP_ALLOWED_HOSTS=

# ── ChatGPT MCP OAuth ─────────────────────────────────────────────────────

# Public https origin of egc-mcp (e.g. https://mcp.easygaragecleaning.com) used in OAuth metadata. Unset: OAuth fails in production; http://localhost:4200 in development. [plain; Railway egc-mcp]
MCP_PUBLIC_ORIGIN=
# Private EGC admin username for the MCP OAuth login page. Unset: every OAuth login is rejected. [secret; Railway egc-mcp]
MCP_OAUTH_USER=
# Password for the MCP OAuth login page (random, 20+ characters). Unset or shorter: every OAuth login is rejected. [secret; Railway egc-mcp]
MCP_OAUTH_PASSWORD=
# "true" publishes registration_endpoint and accepts RFC 7591 registration at /oauth/register for allowlisted redirect URIs only (Claude and ChatGPT connect with their pinned client ID metadata documents and do not need it). Unset: no dynamic registration; /oauth/register answers 404. [plain; Railway egc-mcp]
MCP_OAUTH_DCR_ENABLED=
# "true" adds "Continue with Employee Hub" to the OAuth consent page so a signed-in Hub owner or manager approves each grant (the Hub needs EGC_MCP_PUBLIC_ORIGIN). Unset: only the shared connector login, as today. [plain; Railway egc-mcp]
MCP_OAUTH_HUB_IDENTITY_ENABLED=
# "false" removes the shared connector login (MCP_OAUTH_USER/MCP_OAUTH_PASSWORD) and stops every grant made with it; set it only after Employee Hub sign-in works. Unset or any other value: the shared login stays available, as today. [plain; Railway egc-mcp]
MCP_OAUTH_SHARED_LOGIN_ENABLED=
# Space- or comma-separated exact extra redirect URIs that dynamically registered OAuth clients may use (https, or http only on localhost/127.0.0.1). Unset: only the Claude and ChatGPT callbacks are allowed. [plain; Railway egc-mcp]
MCP_OAUTH_EXTRA_REDIRECTS=

# ── Internal portal browser authentication ────────────────────────────────

# Basic-auth username for the legacy egc-portal views. Unset: the portal answers "authentication is not configured" (503). [secret; Railway egc-portal]
PORTAL_BASIC_USER=
# Basic-auth password for the legacy egc-portal views (random, strong). Unset: the portal answers "authentication is not configured" (503). [secret; Railway egc-portal]
PORTAL_BASIC_PASSWORD=

# ── Postgres ──────────────────────────────────────────────────────────────

# Postgres connection string (Railway Postgres reference); the local value below is the docker-compose default. Unset: every service fails at startup and migrations refuse to run. [secret; Railway all services]
DATABASE_URL=postgres://egc:egc@localhost:5432/egc

# ── GoHighLevel ───────────────────────────────────────────────────────────
# The private-integration token path needs no OAuth client; webhooks are
# registered in the HighLevel Marketplace app (see docs/railway-deployment.md).

# HighLevel location id for sync, webhooks and write-back; webhooks from other locations are rejected. Unset: HighLevel calls fail and /webhooks/ghl answers webhook_location_not_configured. [plain; Railway egc-worker, egc-api, egc-mcp]
GHL_LOCATION_ID=
# HighLevel private-integration token for reconciliation, scheduling and write-back. Unset: HighLevel calls fail. [secret; Railway egc-worker, egc-api, egc-mcp]
GHL_PRIVATE_INTEGRATION_TOKEN=
# Exactly "true" queues approved walkthrough and contact notes for HighLevel write-back. Unset: nothing is written back to HighLevel. [plain; Railway egc-api, egc-mcp, egc-worker]
GHL_WRITEBACK_ENABLED=false
# Verified HighLevel walkthrough calendar for Hub schedule sync. Unset: the single calendar named like "walkthrough" is used, and ambiguity blocks the sync. [plain; Railway egc-api, egc-mcp]
GHL_WALKTHROUGH_CALENDAR_ID=
# Verified HighLevel customer-jobs calendar for Hub schedule sync. Unset: the single calendar named like "customer jobs" is used, and ambiguity blocks the sync. [plain; Railway egc-api, egc-mcp]
GHL_JOBS_CALENDAR_ID=

# ── Unified Employee Hub operations ───────────────────────────────────────
# Deploy both signed bridge endpoints before activation. The Cloudflare side
# is configured in the root .env.example.

# Exactly "true" enables operations, recordings and the Hub bridge. Unset: operations answer operations_not_enabled. [plain; Railway egc-api, egc-mcp]
EGC_OPERATIONS_ENABLED=false
# Operations workspace; must match Cloudflare. Unset: egc. [plain; Railway egc-api, egc-mcp, egc-worker]
EGC_OPERATIONS_WORKSPACE=egc
# HTTPS origin of egc-api (no path) that egc-mcp signs operations and recording calls to. Unset: MCP operations answer operations_bridge_not_configured. [plain; Railway egc-mcp]
EGC_OPERATIONS_API_ORIGIN=
# HTTPS origin of the Employee Hub (https://easygaragecleaning.com) for API→Hub calls and portal links. Unset: the API has no Hub bridge; portal links use https://easygaragecleaning.com. [plain; Railway egc-api, egc-portal]
# EGC_PORTAL_ORIGIN=
# Bridge signing on egc-api: "v2" (Ed25519 keys derived from API_BEARER_TOKEN) or "legacy". Unset: legacy HMAC; other values fail closed. [plain; Railway egc-api]
EGC_OPERATIONS_SERVICE_AUTH=
# HMAC key shared by egc-api and egc-mcp (identical value on both, 32+ chars). Unset: MCP operations and recordings answer bridge_not_configured. [secret; Railway egc-api, egc-mcp]
EGC_OPERATIONS_MCP_SIGNING_SECRET=
# Legacy HMAC key shared by egc-api and Cloudflare Pages (identical value on both). Unset: legacy Hub↔API envelopes fail closed. [secret; Railway egc-api + Cloudflare Pages secret]
EGC_OPERATIONS_PORTAL_SIGNING_SECRET=
# Temporary: "true" runs the authenticated MCP loopback self-check at startup. Unset: no startup self-check. [plain; Railway egc-mcp]
EGC_OPERATIONS_VERIFY_ON_START=false
# Temporary: "true" (with the self-check and the bridge on) creates and completes one labelled internal canary task per release. Unset: no canary task. [plain; Railway egc-mcp]
EGC_OPERATIONS_CANARY_ON_START=false
# Exactly "true" (with GHL_PRIVATE_INTEGRATION_TOKEN and GHL_LOCATION_ID) lets a signed-in Hub person approve and send an approved message action in one tap (task.send). Unset: task.send answers action_send_disabled and nothing is sent. [plain; Railway egc-api]
EGC_OPERATIONS_ACTION_SEND_ENABLED=false
# Exactly "true" lets the booking reconciler repair Hub↔HighLevel appointment links. Unset: dry-run plans only. [plain; Railway egc-api]
EGC_BOOKING_AUTO_RECONCILE=false
# Exactly "true" adopts verified existing HighLevel bookings into the Hub. Unset: dry-run adoption plans only. [plain; Railway egc-api]
EGC_BOOKING_ADOPT_EXISTING=false
# Comma-separated HighLevel appointment ids reviewed for adoption. Unset: every verified provider booking may be adopted when adoption is on. [plain; Railway egc-api]
EGC_BOOKING_ADOPT_PROVIDER_IDS=
# Comma-separated legacy local job ids reviewed for adoption. Unset: no local job is adopted. [plain; Railway egc-api]
EGC_BOOKING_ADOPT_LOCAL_JOB_IDS=
# Exactly "true" starts the egc-api loop that every 2 minutes asks the Hub for due schedule mirrors (schedule.sync_due, at most 25; each call is the check-in that lets Hub page loads stop auto-retrying them), runs schedule.sync_provider for each with automations off under the visit's own mirror key (never the page's visit key or an MCP requestId), and records failures with schedule.sync_failed; each tick's counts and the Hub's backlog (owned, backing off, parked after 8 of the loop's failures on one key or at once on a ledger refusal no retry clears, oldest failure age) go to sync_cursors schedule_sync:last_result, with one error log line when the scan was capped, every selected sync failed, HighLevel drifted from the Hub or visits are parked. It also makes every schedule.sync_provider egc-api runs (the page's, MCP's and the loop's) read the appointment back after binding: if a concurrent stale write replaced it, the Hub re-queues the visit under a fresh drift key and the sync answers schedule_provider_drift. Only this in-process loop can call those two commands (/operations/rpc refuses them); needs the Hub bridge and the Hub's own EGC_SCHEDULE_SYNC_WORKER=true. Unset: no background schedule sync, and within 10 minutes Hub page loads resume retrying. [plain; Railway egc-api]
EGC_SCHEDULE_SYNC_WORKER=false
# Exactly "true" starts the worker loop that signs a v2 service envelope with API_BEARER_TOKEN (the API root secret; see docs/railway-deployment.md) and POSTs one messaging tick to the Hub's /api/messaging-cron every 15 minutes. Unset: the worker never calls the Hub. [plain; Railway egc-worker]
EGC_MESSAGING_CRON_ENABLED=false
# Exactly "true" makes every worker messaging tick a dry run (the Hub reports what would send and sends nothing). Unset: normal ticks, still governed by the Hub's EGC_SERVER_MESSAGING_ENABLED. [plain; Railway egc-worker]
EGC_MESSAGING_CRON_DRY_RUN=false

# ── Customer state and AI ─────────────────────────────────────────────────

# OpenAI key for voice walkthrough transcription/extraction and customer-evidence extraction. Unset: walkthrough AI fails and customer extraction stays partial. [secret; Railway egc-api, egc-worker]
OPENAI_API_KEY=
# Exactly "true" makes visit recordings use conversation extraction v2 (evidence-checked follow-up kinds, draft suggestions, catalog mentions, preferences) as review-only drafts that are never sent. Unset: the walkthrough extraction is unchanged. [plain; Railway egc-api]
EGC_EXTRACTION_V2=false
# OpenAI model for customer-evidence extraction. Unset: gpt-5.6-luna. [plain; Railway egc-worker, egc-api, egc-mcp, egc-portal]
# CUSTOMER_EVIDENCE_MODEL=
# Work-occurrence ledger rollout: off, shadow or enabled; use the same value on every service (docs/customer-occurrence-ledger.md). Unset: off. [plain; Railway egc-api, egc-mcp, egc-worker, egc-portal]
CUSTOMER_OCCURRENCE_LEDGER_MODE=
# One-time JSON array (max 100) of operator-confirmed customer outcomes imported at worker start; idempotent; holds customer contact ids and verbatim customer text. Unset: nothing is imported. [secret; Railway egc-worker]
EGC_USER_CONFIRMED_BOOTSTRAP_JSON=

# ── Storage ───────────────────────────────────────────────────────────────
# V1 Railway deployment uses filesystem + a persistent volume at STORAGE_PATH.

# Recording storage backend: filesystem or s3. Unset: s3, which then requires the S3_* values. [plain; Railway egc-api]
STORAGE_DRIVER=filesystem
# Filesystem storage root (the Railway volume mount). Unset: /data/egc. [plain; Railway egc-api]
STORAGE_PATH=/data/egc
# S3/R2 endpoint URL when STORAGE_DRIVER=s3. Unset: the AWS default endpoint. [plain; Railway egc-api]
S3_ENDPOINT=
# S3/R2 region when STORAGE_DRIVER=s3. Unset: auto. [plain; Railway egc-api]
S3_REGION=auto
# S3/R2 bucket when STORAGE_DRIVER=s3. Unset: s3 storage throws S3_BUCKET is required. [plain; Railway egc-api]
S3_BUCKET=
# S3/R2 access key id when STORAGE_DRIVER=s3. Unset: s3 storage throws credentials are required. [secret; Railway egc-api]
S3_ACCESS_KEY_ID=
# S3/R2 secret access key when STORAGE_DRIVER=s3. Unset: s3 storage throws credentials are required. [secret; Railway egc-api]
S3_SECRET_ACCESS_KEY=

# ── Meta CRM feedback (worker and MCP only) ───────────────────────────────
# Shadow never sends production events. Activation: docs/meta-conversions.md.

# production sends CRM conversion events to Meta; anything else is shadow. Unset: shadow (no production events). [plain; Railway egc-worker, egc-mcp]
META_CAPI_MODE=shadow
# Meta CRM dataset id events are sent to. Unset: the destination is unverified and production sending is blocked. [plain; Railway egc-worker, egc-mcp]
META_CAPI_DATASET_ID=
# Must equal META_CAPI_DATASET_ID to confirm the destination was verified. Unset: the destination counts as unverified and nothing is sent. [plain; Railway egc-worker, egc-mcp]
META_CAPI_DATASET_VERIFIED_ID=
# Meta Graph API version (vNN.0). Unset or invalid: v25.0. [plain; Railway egc-worker, egc-mcp]
META_CAPI_API_VERSION=v25.0
# Conversions API access token. Unset: production sending and test events are blocked. [secret; Railway egc-worker, egc-mcp]
META_CAPI_ACCESS_TOKEN=
# Test Events code for synthetic test events. Unset: test events cannot be sent. [plain; Railway egc-worker, egc-mcp]
META_CAPI_TEST_EVENT_CODE=
# Comma-separated HighLevel walkthrough calendar ids that count as walkthrough stages. Unset: production sending is blocked. [plain; Railway egc-worker, egc-mcp, egc-api, egc-portal]
META_CAPI_WALKTHROUGH_CALENDAR_IDS=
# Comma-separated HighLevel job calendar ids that count as job stages. Unset: no job-calendar appointment counts as a job stage. [plain; Railway egc-worker, egc-mcp, egc-api, egc-portal]
META_CAPI_JOB_CALENDAR_IDS=
# Exactly "true" after the custom-stage collection review and visual test receipt. Unset: production sending is blocked. [plain; Railway egc-worker, egc-mcp]
META_CAPI_FUNNEL_VERIFIED=false
# Activation instant; events before it are never sent. Unset: production sending is blocked. [plain; Railway egc-worker, egc-mcp]
META_CAPI_START_AT=
# Explicit earlier reconciliation boundary; never relaxes Meta event-age or identity rules. Unset: sending starts at META_CAPI_START_AT. [plain; Railway egc-worker, egc-mcp]
META_CAPI_BACKFILL_START_AT=
# Exactly "true" sends verified sales as Purchase feedback. Unset: sales stay JOB_WON only. [plain; Railway egc-worker, egc-mcp]
META_CAPI_QUALIFIED_SALES_FEEDBACK=false
# Comma-separated stage names allowed to send. Unset: QualifiedLead, Purchase and the seven funnel stages. [plain; Railway egc-worker, egc-mcp]
# META_CAPI_EVENT_STAGES=
# Temporary: "true" runs the private MCP Meta tool/preview self-check at startup (needs MCP_BEARER_TOKEN). Unset: no self-check. [plain; Railway egc-mcp]
META_CAPI_VERIFY_ON_START=false
# Temporary: "true" (shadow mode and the self-check only) sends one synthetic test event at startup; reset afterwards. Unset: no test event. [plain; Railway egc-mcp]
META_CAPI_TEST_ON_START=false

# ── Ad spend and lead-form counts (worker only; read-only toward Meta and Google) ──
# Manual spend for other channels is owner-entered through the Hub and needs none of these.

# Exactly "true" pulls Meta daily spend, impressions and clicks (and lead-form counts when META_LEADGEN_PAGE_IDS is set) every hour. Unset: Meta spend and lead counts are reported unknown (platform not connected). [plain; Railway egc-worker]
EGC_AD_SPEND_META_ENABLED=false
# Exactly "true" pulls Google Ads daily spend, impressions and clicks every hour. Unset: Google Ads spend is reported unknown (platform not connected). [plain; Railway egc-worker]
EGC_AD_SPEND_GOOGLE_ENABLED=false
# First Denver date (YYYY-MM-DD) to backfill spend and lead counts from. Unset or invalid: history starts at the first successful pull (today minus the 3-day restatement window). [plain; Railway egc-worker]
EGC_AD_SPEND_START_DATE=
# Meta system-user token with ads_read (plus leads_retrieval on the page for lead counts). Unset: Meta ingestion is blocked (access_token_missing). [secret; Railway egc-worker]
META_ADS_ACCESS_TOKEN=
# Comma-separated Meta ad account ids (digits, with or without act_). Unset: Meta spend ingestion is blocked (account_ids_missing). [plain; Railway egc-worker]
META_ADS_ACCOUNT_IDS=
# Meta Graph API version for spend and lead reads (vNN.0). Unset or invalid: v25.0. [plain; Railway egc-worker]
META_ADS_API_VERSION=v25.0
# Comma-separated Facebook page ids whose lead forms are counted per form per day. Unset: lead-form counts are not pulled and stay unknown. [plain; Railway egc-worker]
META_LEADGEN_PAGE_IDS=
# Google Ads API developer token (approved for basic access or higher). Unset: Google ingestion is blocked (developer_token_missing). [secret; Railway egc-worker]
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth client id that issued GOOGLE_ADS_REFRESH_TOKEN. Unset: Google ingestion is blocked (oauth_client_missing). [plain; Railway egc-worker]
GOOGLE_ADS_CLIENT_ID=
# OAuth client secret for GOOGLE_ADS_CLIENT_ID. Unset: Google ingestion is blocked (oauth_client_missing). [secret; Railway egc-worker]
GOOGLE_ADS_CLIENT_SECRET=
# OAuth refresh token for a user with read access to the ad accounts (adwords scope). Unset: Google ingestion is blocked (refresh_token_missing). [secret; Railway egc-worker]
GOOGLE_ADS_REFRESH_TOKEN=
# Comma-separated 10-digit Google Ads customer ids (dashes allowed). Unset: Google ingestion is blocked (customer_ids_missing). [plain; Railway egc-worker]
GOOGLE_ADS_CUSTOMER_IDS=
# 10-digit manager (MCC) customer id sent as login-customer-id when access is through a manager account. Unset: no login-customer-id header. [plain; Railway egc-worker]
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Google Ads API version (vNN); keep it on a supported, non-sunset version. Unset or invalid: v23. [plain; Railway egc-worker]
GOOGLE_ADS_API_VERSION=v23

# ── Reserved: kept for reference, NO code reads these today ───────────────

# Reserved, not read: the portal dev port is fixed at 4300 and Railway injects PORT. [reserved, not read]
# PORTAL_PORT=4300
# Reserved, not read: no service calls egc-api through this URL (docs mention it for the portal). [reserved, not read]
# API_URL=http://localhost:4100
# Reserved, not read: no service calls egc-mcp through this URL. [reserved, not read]
# MCP_URL=http://localhost:4200/mcp
# Reserved, not read: the V1 worker has no Redis queue. [reserved, not read]
# REDIS_URL=
# Reserved, not read: the private-integration token path needs no HighLevel OAuth client. [reserved, not read]
# GHL_CLIENT_ID=
# Reserved, not read: the private-integration token path needs no HighLevel OAuth client. [reserved, not read]
# GHL_CLIENT_SECRET=
# Reserved, not read: no error-reporting SDK is installed. [reserved, not read]
# SENTRY_DSN=

# ── MCP safety defaults ───────────────────────────────────────────────────

# Exactly "true" gives the static MCP_BEARER_TOKEN egc:write scope; set only while a writing startup verification (EGC_OPERATIONS_CANARY_ON_START, META_CAPI_VERIFY_ON_START / META_CAPI_TEST_ON_START) runs, then remove it. Unset: the static bearer is read-only. [plain; Railway egc-mcp]
MCP_BEARER_WRITE_ENABLED=
# Exactly "true" re-enables one-step MCP customer sends (conversations.send_message, send_sms, egc.send_followup) when EGC_OPERATIONS_ENABLED=true; this bypasses Hub approval, so leave it unset. Unset: those sends are refused in operations mode. [plain; Railway egc-mcp]
EGC_MCP_DIRECT_SENDS_ENABLED=
# Exactly "true" starts new walks of the Postgres .search reads and conversations.get messages on keyset cursors, which rows added or removed mid-walk cannot shift; remove it to roll back (keyset cursors then answer invalid_cursor and the client starts again). Unset: offset cursors, as before. [plain; Railway egc-mcp]
EGC_MCP_KEYSET_CURSORS=
