{
  "name": "@egc/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "test:recordings:integration": "node --test test/recordings-postgres.check.mjs",
    "test:inbound:integration": "node --test test/inbound-postgres.check.mjs",
    "test:provider-notes:integration": "node --test test/provider-notes-postgres.check.mjs"
  },
  "dependencies": {
    "@egc/ai": "workspace:*",
    "@egc/database": "workspace:*",
    "@egc/ghl": "workspace:*",
    "@egc/lead-audit": "workspace:*",
    "@egc/schemas": "workspace:*",
    "@egc/storage": "workspace:*",
    "@fastify/multipart": "^9.2.1",
    "drizzle-orm": "0.44.5",
    "fastify": "^5.6.1",
    "fastify-raw-body": "^5.0.0",
    "zod": "4.6.4",
    "@egc/operations": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  }
}
