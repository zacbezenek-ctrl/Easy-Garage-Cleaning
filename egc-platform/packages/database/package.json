{
  "name": "@egc/database",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "migrate:runtime": "node dist/migrate.js"
  },
  "dependencies": {
    "drizzle-orm": "0.44.5",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
    "typescript": "^6.0.2"
  }
}
