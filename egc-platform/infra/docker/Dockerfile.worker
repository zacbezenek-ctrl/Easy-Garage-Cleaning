FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @egc/schemas build \
 && pnpm --filter @egc/database build \
 && pnpm --filter @egc/ghl build \
 && pnpm --filter @egc/lead-audit build \
 && pnpm --filter @egc/worker build
CMD ["sh", "-c", "pnpm db:push && node apps/worker/dist/worker.js"]
