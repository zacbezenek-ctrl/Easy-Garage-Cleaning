FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
RUN corepack enable
COPY . .
WORKDIR /app/egc-platform
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @egc/schemas build \
 && pnpm --filter @egc/database build \
 && pnpm --filter @egc/customer-state build \
 && pnpm --filter @egc/ghl build \
 && pnpm --filter @egc/lead-audit build \
 && pnpm --filter @egc/operations build \
 && pnpm --filter @egc/storage build \
 && pnpm --filter @egc/ai build \
 && pnpm --filter @egc/api build
CMD ["node", "apps/api/dist/server.js"]
