rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.role != null;
    }

    function businessUser() {
      return signedIn() && request.auth.token.business_access == true;
    }

    function assignmentIdentities() {
      // Older valid sessions keep canonical username access, never unchecked labels.
      return request.auth.token.get('assignment_version', 0) == 1 &&
        request.auth.token.get('assignment_identities', []) is list
        ? request.auth.token.assignment_identities : [request.auth.token.username];
    }

    function assignmentKeys() {
      return request.auth.token.get('assignment_version', 0) == 1 &&
        request.auth.token.get('assignment_keys', []) is list
        ? request.auth.token.assignment_keys : [request.auth.token.username.trim().lower()];
    }

    function assignedCrewMemberMatches(value, keys, username) {
      // A supplied account ID always wins over a display label on that object.
      // Existence checks avoid resolving absent fields for every crew member.
      return value is string ? value.trim().lower() in keys
        : 'username' in value ? (value.username in ['', null]
          ? assignedUserOrIdMatches(value, keys, username) : value.username.trim().lower() == username)
        : 'user' in value ? (value.user in ['', null]
          ? assignedIdOrNameMatches(value, keys, username) : value.user.trim().lower() == username)
        : 'id' in value ? (value.id in ['', null]
          ? 'name' in value && value.name.trim().lower() in keys : value.id.trim().lower() == username)
        : 'name' in value && value.name.trim().lower() in keys;
    }

    function assignedUserOrIdMatches(value, keys, username) {
      return 'user' in value && !(value.user in ['', null])
        ? value.user.trim().lower() == username : assignedIdOrNameMatches(value, keys, username);
    }

    function assignedIdOrNameMatches(value, keys, username) {
      return 'id' in value && !(value.id in ['', null])
        ? value.id.trim().lower() == username : 'name' in value && value.name.trim().lower() in keys;
    }

    function assignedCrewMatches(crew, keys, username) {
      // Rules have no list mapping/iteration. The scheduling API caps crews at
      // 20; check each entry independently so malformed neighbors cannot block
      // legitimate identities or turn an object's label into an account ID.
      return assignedCompactCrewListMatches(crew, keys, username) ||
        assignedCrewMemberMatches(crew[0], keys, username) ||
        assignedCrewMemberMatches(crew[1], keys, username) ||
        assignedCrewMemberMatches(crew[2], keys, username) ||
        assignedCrewMemberMatches(crew[3], keys, username) ||
        assignedCrewMemberMatches(crew[4], keys, username) ||
        assignedCrewMemberMatches(crew[5], keys, username) ||
        assignedCrewMemberMatches(crew[6], keys, username) ||
        assignedCrewMemberMatches(crew[7], keys, username) ||
        assignedCrewMemberMatches(crew[8], keys, username) ||
        assignedCrewMemberMatches(crew[9], keys, username) ||
        assignedCrewMemberMatches(crew[10], keys, username) ||
        assignedCrewMemberMatches(crew[11], keys, username) ||
        assignedCrewMemberMatches(crew[12], keys, username) ||
        assignedCrewMemberMatches(crew[13], keys, username) ||
        assignedCrewMemberMatches(crew[14], keys, username) ||
        assignedCrewMemberMatches(crew[15], keys, username) ||
        assignedCrewMemberMatches(crew[16], keys, username) ||
        assignedCrewMemberMatches(crew[17], keys, username) ||
        assignedCrewMemberMatches(crew[18], keys, username) ||
        assignedCrewMemberMatches(crew[19], keys, username);
    }

    function assignedCompactCrewListMatches(crew, keys, username) {
      // Native whole-map equality keeps common one-field crew lists within the
      // Rules expression budget. Richer maps still use account-first matching.
      let identities = assignmentIdentities();
      return crew.hasAny([
        {'username': identities[0]}, {'username': username},
        {'user': identities[0]}, {'user': username},
        {'id': identities[0]}, {'id': username},
        {'name': identities[0]}, {'name': username}
      ]) || (identities.size() > 1 && crew.hasAny([
        {'name': identities[1]}, {'name': keys[1]}
      ]));
    }

    function assignedToUser(data) {
      return signedIn() && (request.auth.token.get('assignment_version', 0) == 1 &&
        request.auth.token.get('assignment_keys', []) is list
        ? assignedDataMatches(data, request.auth.token.assignment_keys, request.auth.token.assignment_keys[0])
        : assignedDataMatches(data, [request.auth.token.username.trim().lower()], request.auth.token.username.trim().lower()));
    }

    function assignedDataMatches(data, keys, username) {
      return 'assignedCrew' in data && data.assignedCrew is list && data.assignedCrew.size() > 0
        ? assignedCrewMatches(data.assignedCrew, keys, username)
        : 'assignedTo' in data && data.assignedTo is string &&
          data.assignedTo.trim().lower().split('\\s*(?:,|\\+|&|\\band\\b)\\s*').hasAny(keys);
    }

    function ownAvailability(data) {
      return signedIn() && data.type == 'availability' &&
        data.employee is string && data.employee.trim().lower() in assignmentKeys();
    }

    // assignedUpdateIsSafe, ownAvailabilityCreateIsSafe, ownAvailabilityUpdateIsSafe
    // and assignedCustomerCloseoutIsSafe are intentionally bound to no match:
    // every crew write goes through the session-authorized APIs (field-jobs,
    // crew-jobs, crew-availability). They record the crew field allowlists those
    // APIs mirror; binding one again needs new emulator tests first.
    function assignedUpdateIsSafe() {
      // Unchanged assignment fields make a second assignment evaluation redundant.
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.get('assignedTo', '') == resource.data.get('assignedTo', '') &&
        request.resource.data.get('assignedCrew', []) == resource.data.get('assignedCrew', []) &&
        assignedToUser(resource.data) &&
        (!changed.hasAny(['status', 'pipelineStatus', 'payment', 'invoice']) || (
          assignedStageUpdateIsSafe() && assignedPaymentUpdateIsSafe() && assignedInvoiceUpdateIsSafe())) &&
        changed.hasOnly([
          'status', 'pipelineStatus', 'startedAt', 'completedAt', 'updatedAt',
          'preJobProgress', 'preJobChecklist', 'postJobProgress', 'postJobChecklist',
          'importantItemNotes', 'importantItemPhotoCount', 'importantItemsUpdatedAt',
          'importantItemsRecordedAt', 'importantItemsVerifiedAt',
          'arrivalTextStatus', 'lastCustomerMessage',
          'lifecycleSync', 'lifecycleSyncPayload', 'lifecycleSyncAttempts',
          'lifecycleSyncError', 'lifecycleSyncNextRetryAt', 'highlevelContactId',
          'photoDriveUrl', 'proofPhotoCount', 'afterPhotoCount', 'receiptPhotoCount',
          'photoSyncStatus', 'photoSyncError', 'photoSyncedAt',
          'actualLoads', 'hoursOnSite', 'timeTracking', 'dumpFees', 'closeoutNotes',
          'closeoutPreJobException', 'scopeVariance', 'payment', 'invoice',
          'paymentSyncStatus', 'paymentSyncPayload', 'paymentSyncError',
          'paymentSyncNextRetryAt', 'closeoutSyncStatus', 'closeoutSyncPayload',
          'closeoutIdempotencyKey', 'closeoutSyncAttempts', 'closeoutSyncError',
          'closeoutSyncNextRetryAt', 'reviewStatus', 'reviewRequestedAt',
          'reviewRequestId'
        ]);
    }

    function assignedStageUpdateIsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'pipelineStatus']) ||
        changedAssignedStageIsSafe();
    }

    function changedAssignedStageIsSafe() {
      let crewStages = ['scheduled', 'dispatched', 'arrived', 'in_progress', 'completed'];
      let currentStatus = resource.data.get('status', '');
      let currentPipeline = resource.data.get('pipelineStatus', '');
      let nextStatus = request.resource.data.get('status', '');
      let nextPipeline = request.resource.data.get('pipelineStatus', '');
      let preservesVerifiedPaid =
        currentStatus == 'paid' && currentPipeline == 'paid' &&
        nextStatus == 'paid' && nextPipeline == 'paid' &&
        'payment' in resource.data && resource.data.payment.verified == true &&
        request.resource.data.payment == resource.data.payment;
      return preservesVerifiedPaid || (nextStatus == 'paid' && nextPipeline == 'paid'
        ? savedPaymentIsSettled()
        : currentStatus != 'paid' && currentPipeline != 'paid' &&
          nextStatus in crewStages && nextPipeline in crewStages);
    }

    function savedPaymentIsSettled() {
      // Stripe saves these facts before crew closeout advances the job stage.
      // A verified partial payment alone must never authorize a paid closeout.
      let payment = resource.data.get('payment', {});
      let invoice = resource.data.get('invoice', {});
      return payment is map && invoice is map && payment.get('verified', false) == true &&
        invoice.get('status', '') == 'paid' && invoice.get('amount', 0) > 0 &&
        invoice.get('balance', 1) >= 0 && invoice.get('balance', 1) < 0.01 &&
        payment.get('amount', 0) >= invoice.amount - 0.01 &&
        request.resource.data.get('payment', {}) == payment;
    }

    function assignedPaymentUpdateIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['payment']) ||
        (('payment' in resource.data && 'verified' in resource.data.payment && resource.data.payment.verified == true)
          ? request.resource.data.payment == resource.data.payment
          : ('payment' in request.resource.data &&
            (!('verified' in request.resource.data.payment) || request.resource.data.payment.verified != true)));
    }

    function assignedInvoiceUpdateIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let currentInvoice = resource.data.get('invoice', {});
      return !changed.hasAny(['invoice']) ||
        (currentInvoice is map && currentInvoice.get('status', '') == 'paid'
          ? savedPaymentIsSettled() && request.resource.data.invoice.diff(resource.data.invoice).affectedKeys().hasOnly(['updatedAt'])
          : 'invoice' in request.resource.data && request.resource.data.invoice.status != 'paid');
    }

    function ownAvailabilityCreateIsSafe() {
      return ownAvailability(request.resource.data) &&
        request.resource.data.keys().hasOnly([
          'id', 'type', 'recordType', 'employee', 'date', 'time', 'endTime',
          'allDay', 'reason', 'status', 'createdAt', 'updatedAt'
        ]);
    }

    function ownAvailabilityUpdateIsSafe() {
      return ownAvailability(resource.data) && ownAvailability(request.resource.data) &&
        request.resource.data.employee == resource.data.employee &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelledAt', 'updatedAt'
        ]);
    }

    function auditEntryIsSafe() {
      // serverAt must be FieldValue.serverTimestamp(), so it is the trusted
      // ordering time. 'at' remains the ISO copy that older readers display.
      // string.size() counts UTF-16 code units; the Hub clips to these bounds.
      let entry = request.resource.data;
      return entry.keys().hasOnly(['action', 'detail', 'by', 'at', 'serverAt']) &&
        entry.keys().hasAll(['action', 'by', 'at', 'serverAt']) &&
        entry.by == request.auth.token.username &&
        entry.action is string && entry.action.size() > 0 && entry.action.size() <= 200 &&
        entry.get('detail', '') is string && entry.get('detail', '').size() <= 2000 &&
        entry.at is string &&
        entry.at.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?Z') &&
        entry.serverAt == request.time;
    }

    function assignedCustomerCloseoutIsSafe() {
      return signedIn() && resource.data.latestJobId is string &&
        request.resource.data.latestJobId == resource.data.latestJobId &&
        assignedToUser(get(/databases/$(database)/documents/jobs/$(resource.data.latestJobId)).data) &&
        assignedCustomerPaymentSummaryIsSafe() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'latestPhotoFolderUrl', 'latestProofPhotoCount', 'photoUpdatedAt',
          'lastServiceAt', 'lastCloseoutNotes', 'lastPaymentStatus',
          'lastPaymentBalance', 'updatedAt'
        ]);
    }

    function assignedCustomerPaymentSummaryIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let job = get(/databases/$(database)/documents/jobs/$(resource.data.latestJobId)).data;
      return !changed.hasAny(['lastPaymentStatus', 'lastPaymentBalance']) ||
        ('invoice' in job && request.resource.data.lastPaymentBalance == job.invoice.balance && (
          (request.resource.data.lastPaymentStatus == 'paid' &&
            job.invoice.status == 'paid' && 'payment' in job && job.payment.verified == true) ||
          (request.resource.data.lastPaymentStatus == 'pending_verification' &&
            job.invoice.status == 'pending_verification') ||
          (request.resource.data.lastPaymentStatus == 'partial' && job.invoice.status == 'partial') ||
          (request.resource.data.lastPaymentStatus == 'unpaid' && job.invoice.status == 'ready')
        ));
    }

    function serverOwnedJobRecord(documentId) {
      // Operation receipts, provider/adoption proofs and encrypted employee
      // records are written only by the service account. Manager schedule
      // saves still maintain the shared _egc_schedule_lock_* capacity locks.
      return documentId.matches('(secure_|_egc_).*') && !documentId.matches('_egc_schedule_lock_.*');
    }

    function serverOwnedJobData(data, documentId) {
      // Server readers select vaults and receipts by recordType and fail closed
      // on a row they cannot open, so one forged row under any id would block
      // them. Browser SDK writers use only crew_availability (approved PTO) and
      // schedule_lock, which is valid only under its _egc_schedule_lock_ id.
      // Imported Jobber visit history (jobber_history) is read-only history.
      let recordType = data.get('recordType', '');
      return recordType in [
          'employee_hub_v2', 'employee_account_v1', 'schedule_operation',
          'schedule_provider_receipt', 'schedule_adoption', 'operational_record_receipt',
          'recurring_plan', 'quo_message_receipt', 'jobber_history'
        ] || (recordType == 'schedule_lock' && !documentId.matches('_egc_schedule_lock_.*'));
    }

    function laborCopy(data, key) {
      let costs = data.get('costs', null);
      return costs is map ? costs.get(key, null) : null;
    }

    function laborCopiesKept(next, previous) {
      return next.get('laborCost', null) == previous.get('laborCost', null) &&
        laborCopy(next, 'labor') == laborCopy(previous, 'labor') &&
        laborCopy(next, 'laborCents') == laborCopy(previous, 'laborCents');
    }

    function laborCopiesKeptOrDropped(next, previous) {
      return next.get('laborCost', null) in [null, previous.get('laborCost', null)] &&
        laborCopy(next, 'labor') in [null, laborCopy(previous, 'labor')] &&
        laborCopy(next, 'laborCents') in [null, laborCopy(previous, 'laborCents')];
    }

    function jobLaborUnchanged(next, previous, documentId) {
      // JOB-COST-PRIVACY: labor dollars live in the server-only jobLaborCosts
      // record, because every business user reads jobs (on a one-person job,
      // labor over hours is that employee's rate). A browser write keeps the
      // copy an older save left on a job, never adds or changes one, and drops
      // or blanks one only once the job's private record exists (the owner's
      // figure is kept there; scripts/backfill-job-labor-private.mjs moves the
      // rest). A blank costs.labor on a job with no copy stays allowed.
      return laborCopiesKept(next, previous) ||
        laborCopiesKeptOrDropped(next, previous) &&
        exists(/databases/$(database)/documents/jobLaborCosts/$(documentId));
    }

    // FUN-33: the paid-in-full crossing the server money writers keep on a job
    // (paidInFullAt/paidInFullRevision, the reopen, and a payment whose funnel
    // event could not be built). The next writer reads them as the last crossing
    // and the floor of its clock, so a browser edit could duplicate or hide one.
    function paymentEventFields() {
      return ['paidInFullAt', 'paidInFullRevision', 'balanceReopenedAt', 'balanceReopenedReason', 'paymentEventIssue'];
    }

    // Canonical jobs include financial evidence, signatures and private notes.
    // Crew reads and execution writes go through assigned-only server DTOs;
    // otherwise direct SDK reads would bypass projection and completion gates.
    // Managers retain the established administrative workflows. Until FUN-27
    // denies SDK writes to giftWallet, customerDecisions, rebookingRequests and
    // garageGuard, the FUN-36 credit limits bind only /api/customer-lifecycle.
    match /jobs/{documentId} {
      allow read: if businessUser() || ownAvailability(resource.data);
      // Crew mutations use the session-authorized APIs and shared capacity locks.
      // Business SDK writes can neither touch nor produce a server-owned record.
      // funnelSale (FUN-03) names the sale the funnel ledger counts for the job;
      // only the server writers that record or retire that sale may set it. The
      // FUN-33 paid-in-full fields (paymentEventFields) are server-only the same way.
      // ghlTagEntry (GHL-TRACK-1) points at the visit's HighLevel tag outbox entry,
      // which decides whether the browser sync adds the booking tags; only the
      // server commit that writes the entry may set it.
      allow create: if businessUser() && !serverOwnedJobRecord(documentId) &&
        !serverOwnedJobData(request.resource.data, documentId) &&
        !('funnelSale' in request.resource.data) &&
        !request.resource.data.keys().hasAny(paymentEventFields()) &&
        !('ghlTagEntry' in request.resource.data) &&
        jobLaborUnchanged(request.resource.data, {}, documentId);
      allow update: if businessUser() && !serverOwnedJobRecord(documentId) &&
        !serverOwnedJobData(resource.data, documentId) &&
        !serverOwnedJobData(request.resource.data, documentId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['funnelSale', 'ghlTagEntry']) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(paymentEventFields()) &&
        jobLaborUnchanged(request.resource.data, resource.data, documentId);
      allow delete: if businessUser() && !serverOwnedJobRecord(documentId) &&
        !serverOwnedJobData(resource.data, documentId);
    }

    match /customers/{documentId} {
      allow read, create, delete: if businessUser();
      allow update: if businessUser();
    }
    match /leads/{documentId} {
      allow read, write: if businessUser();
    }
    // Retired /quote?id= contract links. Estimates now live on the canonical
    // job; no browser reads or writes these records, so they are server-only.
    match /quotes/{documentId} {
      allow read, write: if false;
    }
    match /blocked_days/{documentId} {
      allow read, write: if businessUser();
    }
    match /blocked_slots/{documentId} {
      allow read, write: if businessUser();
    }
    // The Hub audit trail is append-only and attributed to the signed-in manager.
    match /audit_log/{documentId} {
      allow read: if businessUser();
      allow create: if businessUser() && auditEntryIsSafe();
      allow update, delete: if false;
    }

    // Authentication records and retired contract records are server-only.
    match /employee_profiles/{documentId} {
      allow read, write: if false;
    }
    match /employee_accounts/{documentId} {
      allow read, write: if false;
    }
    match /contracts/{documentId} {
      allow read, write: if false;
    }

    // Invitation claims and delivery status are authoritative server records.
    // The job holds only a display copy, so stale schedule saves cannot resend.
    match /portal_invitations/{documentId} {
      allow read, write: if false;
    }

    // Customer portal link revocation receipts (idempotency, audit) are written
    // only by the server with the service account.
    match /customerPortalOperations/{documentId} {
      allow read, write: if false;
    }

    // Jobber import run receipts (scripts/jobber-import.mjs, service account).
    match /jobberImport/{documentId} {
      allow read, write: if false;
    }

    // Jobber coexistence guard checks (scripts/jobber-guard.mjs, service
    // account); owners and managers read the latest through /api/jobber-guard.
    match /jobberGuard/{documentId} {
      allow read, write: if false;
    }
    match /jobberGuardRuns/{documentId} {
      allow read, write: if false;
    }

    // The Hub audit trail and single-use confirmation receipts are written
    // only by server commits; owners read the audit through /api/hub-audit.
    match /hub_audit/{documentId} {
      allow read, write: if false;
    }
    match /confirm_tokens/{documentId} {
      allow read, write: if false;
    }

    // Approved-send ledger, owner-approved message wording and request
    // receipts are server-only. Browsers use /api/messages and templates APIs.
    match /message_sends/{documentId} {
      allow read, write: if false;
    }
    match /message_templates/{documentId} {
      allow read, write: if false;
    }
    match /message_operations/{documentId} {
      allow read, write: if false;
    }
    // Owner reminder cadence, the signed messaging cron's run summaries and
    // its same-day holds are written only by the server; browsers never read
    // or change them.
    match /messaging_settings/{documentId} {
      allow read, write: if false;
    }
    match /messaging_runs/{documentId} {
      allow read, write: if false;
    }
    match /messaging_holds/{documentId} {
      allow read, write: if false;
    }

    // Website lead delivery receipts (FUN-13): written by /api/web-lead before
    // the HighLevel sync, retried by the signed messaging cron. The sealed lead
    // is cleared after the sync (or 30 days after the receipt is abandoned);
    // this is never a browser lead store.
    match /web_lead_receipts/{documentId} {
      allow read, write: if false;
    }

    // Garage Guard memberships, their Stripe event receipts and identity reviews
    // are written only by the signed Stripe webhook. Jobs carry a display copy.
    match /memberships/{documentId} {
      allow read, write: if false;
    }
    match /stripe_events/{documentId} {
      allow read, write: if false;
    }
    match /membership_reviews/{documentId} {
      allow read, write: if false;
    }
    // Receipts for Garage Guard member-visit and visit-count actions (FUN-20,
    // /api/garage-guard-members), written in the same commit as the change.
    match /garage_guard_operations/{documentId} {
      allow read, write: if false;
    }
    // Confirmed crew card charges the webhook held off their job for a manager.
    match /payment_reviews/{documentId} {
      allow read, write: if false;
    }
    // Single-use receipts for Hub approvals of MCP OAuth grants (/api/mcp-grant).
    match /mcp_grant_nonces/{documentId} {
      allow read, write: if false;
    }
    // Receipts for review resolutions made in the Hub (/api/stripe-reviews).
    match /stripe_review_operations/{documentId} {
      allow read, write: if false;
    }

    // Owner-entered standard costs for stocked catalog items and their save
    // receipts. Managers read and the owner writes them via /api/standard-costs.
    match /catalogStandardCosts/{documentId} {
      allow read, write: if false;
    }
    match /catalogStandardCostOperations/{documentId} {
      allow read, write: if false;
    }

    // JOB-COST-PRIVACY: owner-entered job labor dollars and their save
    // receipts. Only the server reads or writes them, for a viewer who sees
    // labor dollars, via /api/job-labor-costs and /api/money.
    match /jobLaborCosts/{documentId} {
      allow read, write: if false;
    }
    match /jobLaborCostOperations/{documentId} {
      allow read, write: if false;
    }

    // Client Login: rate-limit counters, single-use sign-in links and
    // account sessions hold keyed digests only and are written only by the
    // server. A browser must never read, forge or delete them.
    match /rate_limits/{documentId} {
      allow read, write: if false;
    }
    match /customer_login_links/{documentId} {
      allow read, write: if false;
    }
    match /customer_sessions/{documentId} {
      allow read, write: if false;
    }

    // Hub bridge command receipts hold the audited before/after and the
    // idempotency fingerprint for every registry write. Server-only.
    match /hub_command_operations/{documentId} {
      allow read, write: if false;
    }

    // Portal documents settings (certificate of insurance Drive pointer,
    // upload claims and history) are server-only; customers get the file
    // through the session-checked proxy and staff through the Hub API.
    match /portal_settings/{documentId} {
      allow read, write: if false;
    }

    // Money API request receipts and invoice-number reservations are written
    // only in the same server commit as the job change (/api/money).
    match /moneyOperations/{documentId} {
      allow read, write: if false;
    }
    match /moneyInvoiceNumbers/{documentId} {
      allow read, write: if false;
    }

    // Customer credit, gift-card sale, decision and rebooking request receipts,
    // the gift-card sales ledger (cash received for a card) and its payment
    // reference claims are written only in the same server commit as the
    // account or job change (/api/customer-lifecycle).
    match /lifecycleOperations/{documentId} {
      allow read, write: if false;
    }
    match /giftCardSales/{documentId} {
      allow read, write: if false;
    }
    match /giftCardSaleRefs/{documentId} {
      allow read, write: if false;
    }

    // Quote draft save/send receipts are written only in the same server
    // commit as the quote (/api/quote-draft).
    match /quoteDraftOperations/{documentId} {
      allow read, write: if false;
    }

    // Staff directory and employee vault migration receipts are written only by
    // server commits with the sealed profiles; browsers use /api/staff-directory.
    match /staffDirectoryOperations/{documentId} {
      allow read, write: if false;
    }
    match /employeeVaultMigrations/{documentId} {
      allow read, write: if false;
    }
    // STAFF-ACCESS receipts (sign-in resets, password changes, account reviews,
    // Apply rate) and the payroll week export records are server-only too.
    match /staffAccessOperations/{documentId} {
      allow read, write: if false;
    }
    match /payrollWeekExports/{documentId} {
      allow read, write: if false;
    }

    // Garage catalog versions (immutable snapshots and the published pointer),
    // owner pricing settings, every saved settings version and their request
    // receipts are server-only. Managers read and the owner writes them
    // through /api/catalog.
    match /catalogVersions/{documentId} {
      allow read, write: if false;
    }
    match /pricingSettings/{documentId} {
      allow read, write: if false;
    }
    match /pricingSettingsVersions/{documentId} {
      allow read, write: if false;
    }
    match /catalogOperations/{documentId} {
      allow read, write: if false;
    }

    // Funnel event ledger (FUN-01): append-only rows written only in the same
    // server commit as their business change. Staff read through the API and
    // the platform through the signed bridge; no SDK session reads or writes.
    match /funnelEvents/{documentId} {
      allow read, write: if false;
    }

    // Crew schedule notices (CREW-NOTIFY) are queued only in the dispatch
    // commit and delivered by the messaging cron; employees read and
    // acknowledge their own through /api/crew-notifications, which also keeps
    // their schedule-text opt-in. No SDK session reads or writes either.
    match /crewNotifications/{documentId} {
      allow read, write: if false;
    }
    match /crewNotificationPrefs/{documentId} {
      allow read, write: if false;
    }
    // What each employee last heard about each job: written only with the
    // cron's notice closes, read by the cron and /api/crew-notifications.
    match /crewNoticeHeard/{documentId} {
      allow read, write: if false;
    }

    // HighLevel tag outbox (GHL-TRACK-1): written only in the server commit of a
    // schedule change or walkthrough outcome, drained by /api/ghl-tag-drain.
    match /ghlTagOutbox/{documentId} {
      allow read, write: if false;
    }
    // The HighLevel tag worker's check-in, written by each signed drain tick and
    // read by the Command center's stuck view.
    match /ghlTagDrainState/{documentId} {
      allow read, write: if false;
    }

    // Walkthrough visit request receipts and each rep's open-walkthrough lock
    // (FUN-05) are written only in the server commit that records the visit.
    match /walkthroughVisitOperations/{documentId} {
      allow read, write: if false;
    }
    match /walkthroughVisitLocks/{documentId} {
      allow read, write: if false;
    }

    // Operations settings (P3-04 follow-up owner and due-time policy) are written
    // only by the owner through /api/operations-followup-settings with a hub_audit entry.
    match /operations_settings/{documentId} {
      allow read, write: if false;
    }
    // Crew public profiles (first name, approved headshot pointer, customer
    // visibility) and their request receipts are server-only. Staff use
    // /api/crew-public-profile; customers get only a first name and a signed,
    // session-checked photo link through the portal.
    match /crew_public_profiles/{documentId} {
      allow read, write: if false;
    }
    match /crew_profile_operations/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
